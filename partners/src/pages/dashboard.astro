---
import Portal from '../layouts/Portal.astro';
---

<Portal title="Overview">
  <h1 class="text-2xl font-bold tracking-tight">Overview</h1>
  <p id="dash-loading" class="mt-4 text-sm text-slate-500">Loading…</p>
  <p id="dash-error" class="mt-4 text-sm text-rose-600" hidden></p>

  <div id="dash-suspended" hidden class="mt-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
    This partner account is currently suspended. Reach out to the FitCreature team if that's unexpected.
  </div>

  {/* Agreements gate (annex §10): blocking until every required kind's
      CURRENT version is accepted; re-appears whenever a new version lands. */}
  <section id="dash-agreements" hidden class="mt-6 rounded-lg border border-indigo-200 bg-indigo-50 p-5">
    <h2 class="text-sm font-semibold text-indigo-900">Agreements to review</h2>
    <p class="mt-1 text-sm text-indigo-900/80">
      Before submitting listing changes, downloading your print pack, or viewing reports, please read and
      accept the current version of each agreement.
    </p>
    <ul id="agreement-list" class="mt-4 space-y-3"></ul>
  </section>

  <section id="dash-main" hidden class="mt-8 grid gap-4 sm:grid-cols-2">
    <a href="/listing" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-300">
      <h2 class="font-semibold">Your listing</h2>
      <p id="card-listing" class="mt-1 text-sm text-slate-600"></p>
    </a>
    <a href="/report" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-300">
      <h2 class="font-semibold">Performance report</h2>
      <p class="mt-1 text-sm text-slate-600">Scans, redemptions, and campaign-driven signups for your code.</p>
    </a>
    <a href="/print-pack" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-300">
      <h2 class="font-semibold">Print pack</h2>
      <p class="mt-1 text-sm text-slate-600">Your QR at print resolution, plus copy you can use as-is.</p>
    </a>
    <a href="/account" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-300">
      <h2 class="font-semibold">Account</h2>
      <p class="mt-1 text-sm text-slate-600">Password, email, extra sign-in security, your signed agreements.</p>
    </a>
  </section>
</Portal>

<script>
  import { requireSession, rpc, callFnJson, el, show, toast } from '../lib/portal';

  interface AgreementKind {
    kind: string;
    required: boolean;
    current_version_id: string | null;
    current_version: string | null;
    accepted: boolean;
  }

  const KIND_LABELS: Record<string, string> = {
    terms: 'Partner terms',
    brand_license: 'Brand license',
    content_policy: 'Content policy',
    placement_addendum: 'Placement addendum',
  };

  async function refresh(): Promise<void> {
    const listing = await rpc<Record<string, any>>('get_my_partner_listing');
    show('dash-loading', false);
    if (listing.status === 'not_a_partner') {
      const err = el('dash-error');
      err.innerHTML = 'This account isn\'t a partner account. Running the program? The admin area is at <a class="underline" href="/admin">/admin</a>.';
      err.hidden = false;
      return;
    }
    if (listing.status !== 'ok') {
      const err = el('dash-error');
      err.textContent = `Could not load your account (${listing.status}).`;
      err.hidden = false;
      return;
    }
    show('dash-suspended', listing.account_status === 'suspended');

    const state = await rpc<Record<string, any>>('get_partner_agreement_state');
    const kinds = (state.kinds ?? []) as AgreementKind[];
    const pending = kinds.filter((k) => k.required && !k.accepted);
    show('dash-agreements', pending.length > 0);
    if (pending.length > 0) {
      const list = el('agreement-list');
      list.innerHTML = '';
      for (const k of pending) {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 rounded-md bg-white px-4 py-3 text-sm';
        const label = document.createElement('span');
        label.textContent = `${KIND_LABELS[k.kind] ?? k.kind}${k.current_version ? ` (v${k.current_version})` : ''}`;
        li.appendChild(label);
        const buttons = document.createElement('span');
        buttons.className = 'flex gap-2';
        if (k.current_version_id) {
          const view = document.createElement('button');
          view.textContent = 'Read';
          view.className = 'rounded-md border border-slate-300 px-3 py-1 hover:bg-slate-100';
          view.addEventListener('click', () => {
            window.open(`/agreement?id=${k.current_version_id}`, '_blank', 'noopener');
          });
          buttons.appendChild(view);
          const accept = document.createElement('button');
          accept.textContent = 'Accept';
          accept.className = 'rounded-md bg-indigo-600 px-3 py-1 font-semibold text-white hover:bg-indigo-500';
          accept.addEventListener('click', async () => {
            const res = await rpc<Record<string, any>>('accept_partner_agreement', {
              p_agreement_version_id: k.current_version_id,
            });
            if (res.status === 'ok' || res.status === 'already_accepted') {
              toast('Accepted.');
              await refresh();
            } else {
              toast(`Could not accept (${res.status}).`);
            }
          });
          buttons.appendChild(accept);
        } else {
          const note = document.createElement('span');
          note.className = 'text-slate-500';
          note.textContent = 'Not yet published';
          buttons.appendChild(note);
        }
        li.appendChild(buttons);
        list.appendChild(li);
      }
    }

    show('dash-main', true);
    const live = listing.live as Record<string, any> | null;
    const draft = listing.draft as Record<string, any> | null;
    const status = draft
      ? { draft: 'Draft in progress', submitted: 'Submitted, in review', changes_requested: 'Changes requested' }[
          String(draft.status)
        ] ?? String(draft.status)
      : 'Live';
    el('card-listing').textContent = `${live?.business_name ?? 'Your business'}: ${status}.`;
  }

  void requireSession().then(refresh).catch((err) => {
    if (String(err).includes('redirecting')) return;
    show('dash-loading', false);
    const node = el('dash-error');
    if (/permission denied/i.test(String(err))) {
      node.innerHTML = 'This account isn\'t a partner account. Running the program? The admin area is at <a class="underline" href="/admin">/admin</a>.';
    } else {
      node.textContent = String(err);
    }
    node.hidden = false;
  });
</script>
