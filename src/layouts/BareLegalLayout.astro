---
import Base from './Base.astro';

// Bare legal layout for the Consumer Health Data Privacy Policy page only.
// The Washington My Health My Data Act FAQ (Attorney General, Question 4) says
// the policy must be "a separate and distinct link" on the homepage and "may
// not contain additional information not required under the My Health My Data
// Act." So this layout renders the policy text alone: no
// header navigation and no footer legal navigation. Every other page keeps
// Base's footer, which links to this page.
const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} | Devtegra`} description={frontmatter.description} siteChrome={false}>
  <article class="prose prose-slate mx-auto max-w-3xl px-6 py-12 prose-headings:tracking-tight prose-a:text-indigo-600">
    <slot />
  </article>
</Base>
