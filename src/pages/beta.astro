---
import Base from '../layouts/Base.astro';

// Beta-tester signup. TEMPORARY page (turned off after recruitment).
//
// Posts to the FitCreature project's public `beta_signup` edge function, which is
// defended by CORS + honeypot + Turnstile + a Postgres rate limiter. Double opt-in:
// a confirmation email must be tapped before the address counts.
//
// GATED until 2026-07-17 00:00 US Central: until then the page shows a "coming
// soon" card and the form stays hidden (the reveal script below flips it on the
// date). The BACKEND is closed independently via the BETA_SIGNUPS_OPEN kill switch
// (flipped open by hand on the 17th) so a determined visitor can't submit early.
//
// The Turnstile SITE key is public (safe to embed in HTML) and is the "FitCreature
// Turnstile" widget's key. Hardcoded as the default so the static Pages build needs
// no build-time env var; PUBLIC_TURNSTILE_SITE_KEY can still override it. The real
// Turnstile SECRET lives server-side on the edge function, so the site key alone
// grants nothing.
const SIGNUP_ENDPOINT =
  import.meta.env.PUBLIC_BETA_SIGNUP_URL ||
  'https://oonouwvcegrmudmjkmds.supabase.co/functions/v1/beta_signup';
const TURNSTILE_SITE_KEY =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAD0AwX_WOU72V94u';
---

<Base
  title="Join the FitCreature Beta"
  description="Sign up to be a FitCreature beta tester. Every real workout shapes a single evolving creature."
  noindex={true}
>
  <div class="mx-auto max-w-xl px-6 py-16">
    {/* Coming-soon (visible by default; the reveal script hides it on/after the open date) */}
    <div id="beta-comingsoon">
      <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">FitCreature Beta</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900">Signups open July 17.</h1>
      <p class="mt-5 leading-relaxed text-slate-600">
        We're putting the final touches on the FitCreature beta. Come back on July 17th to leave your email and
        claim a spot on the list.
      </p>
    </div>

    {/* Open state (hidden until the reveal script runs on/after the open date) */}
    <div id="beta-open" hidden>
      <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">FitCreature Beta</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900">Train your creature before anyone else.</h1>
      <p class="mt-5 leading-relaxed text-slate-600">
        FitCreature turns your real workouts into a single evolving creature you battle with. We're opening a limited
        beta. Tell us a little about how you train, and we'll reach out when a spot opens.
      </p>

      <form id="beta-form" class="mt-10 space-y-7" novalidate>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="first-name" class="block text-sm font-medium text-slate-900">First name</label>
            <input
              type="text"
              id="first-name"
              name="firstName"
              required
              autocomplete="given-name"
              placeholder="Alex"
              class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"
            />
          </div>
          <div>
            <label for="last-name" class="block text-sm font-medium text-slate-900">Last name</label>
            <input
              type="text"
              id="last-name"
              name="lastName"
              required
              autocomplete="family-name"
              placeholder="Rivera"
              class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"
            />
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-slate-900">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="mt-2 w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"
          />
        </div>

        <fieldset>
          <legend class="text-sm font-medium text-slate-900">Which phone do you use?</legend>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="radio" name="platform" value="ios" required class="text-indigo-600 focus:ring-indigo-500" />
              iPhone
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="radio" name="platform" value="android" class="text-indigo-600 focus:ring-indigo-500" />
              Android
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="radio" name="platform" value="both" class="text-indigo-600 focus:ring-indigo-500" />
              Both
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-medium text-slate-900">Do you use a fitness tracker?</legend>
          <p class="mt-1 text-xs text-slate-500">Apple Watch, Fitbit, Garmin, a phone app, anything like that.</p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="radio" name="tracker" value="yes" class="text-indigo-600 focus:ring-indigo-500" />
              Yes
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="radio" name="tracker" value="no" class="text-indigo-600 focus:ring-indigo-500" />
              No
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-medium text-slate-900">How do you see yourself training?</legend>
          <p class="mt-1 text-xs leading-relaxed text-slate-500">
            Pick any that feel like you. We use this to invite a well-rounded mix of testers, so we can spot issues
            that only show up for, say, runners or yoga regulars. It shapes who we reach out to, never your creature
            or the game.
          </p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" name="exercise" value="walking" class="rounded text-indigo-600 focus:ring-indigo-500" />
              Walking
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" name="exercise" value="running" class="rounded text-indigo-600 focus:ring-indigo-500" />
              Running
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" name="exercise" value="cycling" class="rounded text-indigo-600 focus:ring-indigo-500" />
              Cycling
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" name="exercise" value="weight_training" class="rounded text-indigo-600 focus:ring-indigo-500" />
              Weight training
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" name="exercise" value="fitness_classes" class="rounded text-indigo-600 focus:ring-indigo-500" />
              Fitness classes
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" name="exercise" value="yoga" class="rounded text-indigo-600 focus:ring-indigo-500" />
              Yoga
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" name="exercise" value="sport_practice" class="rounded text-indigo-600 focus:ring-indigo-500" />
              Sport practice
            </label>
          </div>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-dashed border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" id="exercise-all" class="rounded text-indigo-600 focus:ring-indigo-500" />
              All of the above
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-dashed border-slate-300 px-4 py-3 text-slate-700 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50 has-[:checked]:text-indigo-900">
              <input type="checkbox" id="exercise-none" class="rounded text-indigo-600 focus:ring-indigo-500" />
              None of the above
            </label>
          </div>
        </fieldset>

        {/* Honeypot: hidden from humans, tempting to naive bots. A filled value is
            silently dropped server-side. Off-screen (not display:none) so bots that
            skip hidden fields still see it. */}
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden">
          <label for="website">Website (leave blank)</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>

        <button
          type="submit"
          id="beta-submit"
          class="w-full rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Join the beta
        </button>

        <p id="beta-message" role="status" aria-live="polite" class="hidden text-sm"></p>
      </form>

      <div id="beta-success" class="mt-10 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-6">
        <h2 class="text-lg font-semibold text-emerald-900">Check your inbox</h2>
        <p class="mt-2 leading-relaxed text-emerald-800">
          We just sent a confirmation link to your email. Tap it to lock in your spot on the list, and we'll be in
          touch when the beta opens up. If it isn't there in a minute, check your spam folder.
        </p>
      </div>

      <p class="mt-10 text-xs leading-relaxed text-slate-400">
        We use your name and email only to contact you about the FitCreature beta, your platform to prioritize
        invites, and your tracker and training answers to invite a well-rounded mix of testers. None of it affects
        the app or the game. See our <a href="/privacy-policy" class="text-indigo-500 hover:underline">Privacy
        Policy</a>. This form is protected by Cloudflare Turnstile.
      </p>
    </div>
  </div>

  {/* Reveal gate: runs synchronously at parse. Default stays "coming soon" (safe if
      JS is off or fails). Opens at 00:00 July 17, 2026 US Central (CDT = UTC-5). */}
  <script is:inline>
    (function () {
      var OPEN_AT = Date.parse('2026-07-17T05:00:00Z');
      if (Date.now() >= OPEN_AT) {
        var cs = document.getElementById('beta-comingsoon');
        var op = document.getElementById('beta-open');
        if (cs) cs.hidden = true;
        if (op) op.hidden = false;
      }
    })();
  </script>

  {/* Turnstile loads after the reveal so it scans a visible widget once open. */}
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script define:vars={{ SIGNUP_ENDPOINT }}>
    const form = document.getElementById('beta-form');
    const submitBtn = document.getElementById('beta-submit');
    const message = document.getElementById('beta-message');
    const success = document.getElementById('beta-success');

    // Exercise-focus "All / None of the above" affordances. UI-only: they are
    // never sent as values (the payload carries only the checked category boxes,
    // which the edge function re-validates against its allow-list).
    const exerciseBoxes = Array.from(form.querySelectorAll('input[name="exercise"]'));
    const allBox = document.getElementById('exercise-all');
    const noneBox = document.getElementById('exercise-none');

    exerciseBoxes.forEach((box) =>
      box.addEventListener('change', () => {
        const checked = exerciseBoxes.filter((b) => b.checked).length;
        if (allBox) allBox.checked = checked === exerciseBoxes.length;
        if (noneBox && checked > 0) noneBox.checked = false;
      })
    );
    if (allBox) {
      allBox.addEventListener('change', () => {
        exerciseBoxes.forEach((b) => { b.checked = allBox.checked; });
        if (allBox.checked && noneBox) noneBox.checked = false;
      });
    }
    if (noneBox) {
      noneBox.addEventListener('change', () => {
        if (noneBox.checked) {
          exerciseBoxes.forEach((b) => { b.checked = false; });
          if (allBox) allBox.checked = false;
        }
      });
    }

    function showMessage(text, tone) {
      message.textContent = text;
      message.className =
        'text-sm ' + (tone === 'error' ? 'text-red-600' : 'text-slate-600');
      message.classList.remove('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      message.classList.add('hidden');

      const firstName = document.getElementById('first-name').value.trim();
      const lastName = document.getElementById('last-name').value.trim();
      const email = document.getElementById('email').value.trim();
      const platformEl = form.querySelector('input[name="platform"]:checked');
      const trackerEl = form.querySelector('input[name="tracker"]:checked');
      const usesFitnessTracker = trackerEl ? trackerEl.value === 'yes' : null;
      const exerciseTypes = exerciseBoxes.filter((b) => b.checked).map((b) => b.value);
      const website = document.getElementById('website').value;
      const turnstileToken =
        (form.querySelector('[name="cf-turnstile-response"]') || {}).value || '';

      if (!firstName) return showMessage('Please enter your first name.', 'error');
      if (!lastName) return showMessage('Please enter your last name.', 'error');
      if (!email) return showMessage('Please enter your email.', 'error');
      if (!platformEl) return showMessage('Please pick your phone.', 'error');
      if (!turnstileToken) return showMessage('Please complete the verification and try again.', 'error');

      submitBtn.disabled = true;
      submitBtn.textContent = 'Joining...';

      try {
        const res = await fetch(SIGNUP_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName,
            lastName,
            email,
            platform: platformEl.value,
            usesFitnessTracker,
            exerciseTypes,
            website,
            turnstileToken,
          }),
        });

        if (res.ok) {
          let body = {};
          try { body = await res.json(); } catch (_) { /* ignore */ }
          if (body.status === 'closed') {
            showMessage('Beta signups are closed right now. Thanks for your interest, check back soon.', 'error');
            resetButton();
            return;
          }
          form.classList.add('hidden');
          success.classList.remove('hidden');
          return;
        }

        if (res.status === 429) {
          showMessage("You've tried a few times in a row. Please wait a little while and try again.", 'error');
        } else if (res.status === 400) {
          showMessage('Please double-check your email and the verification, then try again.', 'error');
        } else {
          showMessage('Something went wrong on our end. Please try again in a moment.', 'error');
        }
        resetButton();
      } catch (_) {
        showMessage('We could not reach the server. Please check your connection and try again.', 'error');
        resetButton();
      }
    });

    function resetButton() {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Join the beta';
      if (window.turnstile) {
        try { window.turnstile.reset(); } catch (_) { /* ignore */ }
      }
    }
  </script>
</Base>
