---
import Base from '../layouts/Base.astro';

// FitCreature referral landing (F89 / Decision 6.111 in the app repo).
//
// This URL is the PERMANENT payload of every referral QR baked into shared
// images (evolution/battle clips, workout + streak cards, progress photos)
// and shown on the in-app Refer tab. The scheme — /join?ref=<8-char code> —
// must never change: QRs already posted in the wild can't be reprinted. The
// page CONTENT is free to evolve (beta signup today; App Store / Google Play
// badges + install-referrer links at launch; partner-branded variants later).
//
// Fully static: the ?ref code is read and validated client-side, so page
// load never touches a backend and a traffic spike is just CDN file serving.
// AFTER render, a fire-and-forget POST to the public `ref_scan` edge function
// (F89 Phase 2) counts the scan and, for a PARTNER code, returns branding
// {partner_name, partner_logo_url} that upgrades the headline in place. Any
// failure of that call costs a count + branding, never the page.
//
// Codes are 8 uppercase alphanumerics — wider than the generated-code
// alphabet on purpose: hand-assigned partner/promo codes may use 0/O/1/I/L.
const SCAN_ENDPOINT =
  import.meta.env.PUBLIC_REF_SCAN_URL ||
  'https://oonouwvcegrmudmjkmds.supabase.co/functions/v1/ref_scan';
---

<Base
  title="Join FitCreature"
  description="A friend invited you to FitCreature, the fitness RPG where every real workout shapes an evolving creature. Grab their referral code and start training."
>
  <section class="bg-gradient-to-b from-indigo-50 to-white">
    <div class="mx-auto max-w-xl px-6 py-16 text-center">
      <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-indigo-500 p-4 shadow-lg shadow-indigo-200">
        <img src="/images/fitcreature-icon.png" alt="FitCreature app icon" width="60" height="60" class="invert" />
      </span>

      {/* Referred state (shown when ?ref carries a well-formed code) */}
      <div id="join-referred" hidden>
        <img id="join-partner-logo" src="" alt="" width="72" height="72" class="mx-auto mt-6 rounded-xl" hidden />
        <h1 id="join-headline" class="mt-8 text-4xl font-bold tracking-tight text-slate-900">You've been invited.</h1>
        <p id="join-blurb" class="mt-4 leading-relaxed text-slate-600">
          Someone wants you training beside them in FitCreature, the fitness RPG where
          every real workout shapes an evolving creature. This is their referral code.
          Enter it when you create your account and you'll both earn in-game rewards.
        </p>

        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Referral code</p>
          <p id="join-code" class="mt-3 font-mono text-4xl font-bold tracking-[0.3em] text-slate-900"></p>
          <button
            id="join-copy"
            type="button"
            class="mt-5 rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500"
          >
            Copy code
          </button>
          <p id="join-copied" class="mt-3 text-sm font-medium text-emerald-600" hidden>Copied. Keep it handy for signup.</p>
        </div>
      </div>

      {/* Generic state (no or malformed ?ref) */}
      <div id="join-generic">
        <h1 class="mt-8 text-4xl font-bold tracking-tight text-slate-900">Join FitCreature.</h1>
        <p class="mt-4 leading-relaxed text-slate-600">
          FitCreature is the fitness RPG where every real workout shapes an evolving
          creature that battles for you. Health-first, privacy-first, never pay-to-win.
        </p>
      </div>

      <div class="mt-10 flex flex-col items-center gap-4">
        <a
          href="/beta"
          class="rounded-full bg-slate-900 px-8 py-4 text-base font-semibold text-white shadow-sm transition-colors hover:bg-slate-700"
        >
          Get early access
        </a>
        <p class="text-sm text-slate-500">
          FitCreature is in limited beta ahead of its App Store and Google Play launch.
        </p>
        <a href="/fitcreature" class="text-sm font-medium text-indigo-600 hover:underline">
          Learn more about FitCreature
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-xl px-6 pb-20">
    <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900">How it works</h2>
    <ol class="mt-8 space-y-6">
      <li class="flex gap-4">
        <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-indigo-100 font-semibold text-indigo-600">1</span>
        <p class="leading-relaxed text-slate-600">Get the app and create your account.</p>
      </li>
      <li class="flex gap-4">
        <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-indigo-100 font-semibold text-indigo-600">2</span>
        <p class="leading-relaxed text-slate-600">Enter the referral code during signup (or redeem it later in the app).</p>
      </li>
      <li class="flex gap-4">
        <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-indigo-100 font-semibold text-indigo-600">3</span>
        <p class="leading-relaxed text-slate-600">Train. Your creature evolves with every workout, and your welcome reward unlocks as you level up.</p>
      </li>
    </ol>
  </section>
</Base>

<script define:vars={{ SCAN_ENDPOINT }}>
  // 8 uppercase alphanumerics — wider than the generated-code alphabet on
  // purpose (hand-assigned partner/promo codes may use 0/O/1/I/L).
  const CODE_RE = /^[A-Z0-9]{8}$/;

  const code = (new URLSearchParams(location.search).get('ref') || '')
    .trim()
    .toUpperCase();

  if (CODE_RE.test(code)) {
    document.getElementById('join-generic').hidden = true;
    document.getElementById('join-referred').hidden = false;
    document.getElementById('join-code').textContent = code;

    const copyBtn = document.getElementById('join-copy');
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code);
        document.getElementById('join-copied').hidden = false;
      } catch {
        // Clipboard can be unavailable (permissions, old browsers) — the
        // code stays visible on screen either way.
      }
    });

    // Fire-and-forget scan log AFTER render. A partner code's response
    // upgrades the headline to the partner's branding in place; any failure
    // (offline, rate-limited, endpoint down) changes nothing on the page.
    const ua = navigator.userAgent || '';
    const platform = /android/i.test(ua)
      ? 'android'
      : /iphone|ipad|ipod/i.test(ua)
        ? 'ios'
        : 'other';
    fetch(SCAN_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code, platform }),
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data || data.status !== 'ok') return;
        if (data.code_type === 'partner') {
          if (typeof data.partner_name === 'string' && data.partner_name.length > 0) {
            document.getElementById('join-headline').textContent =
              `A welcome from ${data.partner_name}.`;
            document.getElementById('join-blurb').textContent =
              `${data.partner_name} partners with FitCreature, the fitness RPG where ` +
              `every real workout shapes an evolving creature. Enter their code when ` +
              `you create your account to unlock their welcome perks in the app.`;
          }
          if (typeof data.partner_logo_url === 'string' && data.partner_logo_url.startsWith('https://')) {
            const logo = document.getElementById('join-partner-logo');
            logo.src = data.partner_logo_url;
            logo.alt = typeof data.partner_name === 'string' ? `${data.partner_name} logo` : 'Partner logo';
            logo.hidden = false;
          }
        } else if (data.code_type === 'promo') {
          // Campaign QRs (event booth, stickers, streamer drops) are promo
          // codes: no "someone invited you" framing, and the reward lands at
          // redemption rather than a level gate.
          document.getElementById('join-headline').textContent =
            'You found a FitCreature code.';
          document.getElementById('join-blurb').textContent =
            'FitCreature is the fitness RPG where every real workout shapes an ' +
            'evolving creature. Enter this code when you create your account ' +
            '(or redeem it later in the app) to unlock a welcome reward.';
        }
      })
      .catch(() => {
        // Count + branding lost, page unaffected — deliberately silent.
      });
  }
</script>
