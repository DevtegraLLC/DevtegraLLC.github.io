---
import Portal from '../layouts/Portal.astro';
---

<Portal title="Review queue">
  <h1 class="text-2xl font-bold tracking-tight">Partner review</h1>
  <p class="mt-2 text-sm text-slate-600">
    The F24 console area: submitted drafts, agreement states, takedowns, and cross-partner numbers.
    Sign in with your admin account (not a partner login).
  </p>

  <p id="ad-loading" class="mt-6 text-sm text-slate-500">Loading…</p>
  <p id="ad-denied" hidden class="mt-6 text-sm text-rose-600">This account doesn't have admin access.</p>

  <div id="ad-body" hidden>
    <h2 class="mt-8 text-sm font-semibold">Submitted drafts</h2>
    <p id="ad-queue-empty" hidden class="mt-2 text-sm text-slate-500">Nothing waiting for review.</p>
    <div id="ad-queue" class="mt-3 space-y-4"></div>

    <h2 class="mt-10 text-sm font-semibold">Partners</h2>
    <div id="ad-partners-note" hidden class="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"></div>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[40rem] text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Code</th><th class="py-2 pr-4">Contact</th><th class="py-2 pr-4">Status</th>
            <th class="py-2 pr-4">Terms</th><th class="py-2 pr-4">Brand</th><th class="py-2 pr-4">Content</th>
            <th class="py-2">Actions</th>
          </tr>
        </thead>
        <tbody id="ad-partners"></tbody>
      </table>
    </div>

    <h2 class="mt-10 text-sm font-semibold">Unpublished listings</h2>
    <p id="ad-unpub-empty" hidden class="mt-2 text-sm text-slate-500">None.</p>
    <ul id="ad-unpub" class="mt-3 space-y-2 text-sm"></ul>

    <h2 class="mt-10 text-sm font-semibold">Partner inquiries</h2>
    <p class="mt-1 text-xs text-slate-500">
      Leads from the public /register form. Reach out, mark contacted, close when settled
      (onboarding stays "provision the account" in the runbook).
    </p>
    <p id="ad-inquiries-empty" hidden class="mt-2 text-sm text-slate-500">No inquiries yet.</p>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[44rem] text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Business</th><th class="py-2 pr-4">Contact</th><th class="py-2 pr-4">Phone</th>
            <th class="py-2 pr-4">Received</th><th class="py-2 pr-4">Status</th><th class="py-2">Actions</th>
          </tr>
        </thead>
        <tbody id="ad-inquiries"></tbody>
      </table>
    </div>

    <h2 class="mt-10 text-sm font-semibold">Publish an agreement version</h2>
    <form id="ad-agreement-form" class="mt-3 grid max-w-xl gap-3">
      <div class="grid grid-cols-2 gap-3">
        <select id="ag-kind" class="rounded-md border border-slate-300 px-3 py-2 text-sm">
          <option value="terms">terms</option>
          <option value="brand_license">brand_license</option>
          <option value="content_policy">content_policy</option>
          <option value="placement_addendum">placement_addendum</option>
        </select>
        <input id="ag-version" required placeholder="version, e.g. 1.0" class="rounded-md border border-slate-300 px-3 py-2 text-sm" />
      </div>
      <textarea id="ag-body" rows="6" required placeholder="The full agreement text (markdown). Stored immutably; partners re-accept."
        class="rounded-md border border-slate-300 px-3 py-2 font-mono text-xs"></textarea>
      <button class="justify-self-start rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
        Publish version
      </button>
    </form>

    <h2 class="mt-10 text-sm font-semibold">Cross-partner metrics (30 days)</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[36rem] text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Code</th><th class="py-2 pr-4">Scans (period)</th><th class="py-2 pr-4">Scans (all time)</th>
            <th class="py-2 pr-4">Redemptions</th><th class="py-2">New-user</th>
          </tr>
        </thead>
        <tbody id="ad-metrics"></tbody>
      </table>
    </div>
  </div>

  {/* Step one of the two-step deactivate (Decision 6.152): every consequence is
      named before anything happens. Step two is the confirm on the button. */}
  <div id="deact-overlay" hidden class="fixed inset-0 z-40 flex items-center justify-center bg-slate-900/40 p-4">
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="deact-title"
      class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-xl border border-slate-200 bg-white p-6 shadow-xl"
    >
      <h2 id="deact-title" class="text-base font-semibold">Deactivate this login</h2>
      <p id="deact-sub" class="mt-1 text-xs text-slate-500"></p>

      <p class="mt-4 text-sm text-slate-700">Deactivating a login does all of this at once:</p>
      <ul class="mt-2 list-disc space-y-2 pl-5 text-sm text-slate-700">
        <li>
          It is permanent. A deactivated login cannot be reactivated, and there is no undo.
        </li>
        <li>
          Sign-in ends now. The password stops working, and every open session on this login ends at
          the same moment.
        </li>
        <li>
          Its venue access is removed: every venue it reached, and its brand admin role if it held one.
        </li>
        <li>
          Its agreement acceptance records are kept, unchanged, as the record of what was signed.
        </li>
        <li>
          Bringing this person back needs a new login under a different sign-in address. This address
          stays with the records above and cannot be used again.
        </li>
      </ul>

      <div id="deact-warning" hidden class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"></div>

      <div class="mt-4">
        <label for="deact-note" class="block text-sm font-medium">Note (optional)</label>
        <input
          id="deact-note"
          type="text"
          placeholder="Partnership ended, deletion requested by email…"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
        <p class="mt-1 text-xs text-slate-500">Kept in the admin audit log with this action.</p>
      </div>

      <p id="deact-error" hidden class="mt-3 text-sm text-rose-700"></p>

      <div class="mt-5 flex flex-wrap gap-3">
        <button
          type="button"
          id="deact-cancel"
          class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100"
        >
          Keep this login
        </button>
        <button
          type="button"
          id="deact-go"
          class="rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-500 disabled:opacity-50"
        >
          Deactivate for good
        </button>
      </div>
    </div>
  </div>
</Portal>

<script>
  import { requireSession, rpc, callFn, callFnJson, el, show, toast, fmtDate, roleLabel } from '../lib/portal';

  // Partner-typed text lands in innerHTML below, so it is escaped first.
  const esc = (v: unknown): string =>
    String(v ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

  // ---------------------------------------------------------------------------
  // Deactivating a partner login (BUG_LOG B95, Decision 6.152). A partner login
  // is never deleted: admin_deactivate_partner_login (superadmin only, audited
  // through admin_assert_and_audit before anything moves) removes every grant,
  // revokes every session, bans the sign-in and marks the row 'deactivated',
  // which is terminal. The button sits beside Suspend / Reactivate because the
  // partners table only renders for a seat the superadmin-gated review queue
  // answered; the RPC re-checks the tier itself either way.
  // ---------------------------------------------------------------------------
  type PartnerRow = Record<string, any>;

  /** The badge a deactivated row carries instead of Suspend / Reactivate. */
  const DEACTIVATED_BADGE_TEXT = 'Deactivated';

  let partnerRows: PartnerRow[] = [];
  let deactTarget: PartnerRow | null = null;

  const loginName = (p: PartnerRow): string => String(p.contact_name || p.contact_email || 'this login');
  const brandName = (p: PartnerRow): string => String(p.brand_name || 'this brand');

  // partner_agreements_current needs an ACTIVE brand admin's acceptance of every
  // required agreement (Decision 6.145), so a brand with none has every gated
  // partner action closed for every login on it.
  const NO_ADMIN_EFFECT =
    'nobody on the brand can manage its team, and its gated partner actions (submissions, report downloads, print packs, notification changes) are closed for every login on it';

  /** Heads-up in the panel when this login is the brand's last active brand admin. */
  function lastAdminWarning(p: PartnerRow): string | null {
    if (p.role !== 'brand_admin' || p.status !== 'active') return null;
    const another = partnerRows.some(
      (o) => o.id !== p.id && o.brand_id === p.brand_id && o.status === 'active' && o.role === 'brand_admin',
    );
    if (another) return null;
    return `Going by the list on this page, ${loginName(p)} is the only active brand admin of ${brandName(p)}. Once it is deactivated, the brand has no active brand admin: ${NO_ADMIN_EFFECT} until one is active again.`;
  }

  /** The warning after a deactivation whose result says brand_has_active_admin is false. */
  function noAdminLeftText(target: PartnerRow): string {
    const suspended = partnerRows.find(
      (o) => o.brand_id === target.brand_id && o.status === 'suspended' && o.role === 'brand_admin',
    );
    const next = suspended
      ? `reactivate ${loginName(suspended)}, a suspended brand admin of this brand, below, or provision a new brand admin login.`
      : 'provision a new brand admin login for it.';
    return `${loginName(target)} is deactivated, and ${brandName(target)} has no active brand admin left. Until one is active again, ${NO_ADMIN_EFFECT}. If the partnership continues, ${next}`;
  }

  /**
   * A warning above the partners table. load() clears it on every refresh of
   * the list, because any later Suspend or Reactivate (reactivating the
   * suspended brand admin it suggests, say) can make it untrue; the
   * deactivation handler sets it after its own refresh.
   */
  function partnersWarning(text: string): void {
    const node = el('ad-partners-note');
    node.textContent = text;
    node.hidden = false;
    node.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  /** Soft statuses: the server answered, and nothing changed. */
  const DEACT_STATUS_TEXT: Record<string, string> = {
    already_deactivated: 'That login was already deactivated, so nothing changed.',
    not_found: 'That login could not be found, so nothing changed.',
  };

  /**
   * A raised error rolled the whole call back, audit row included, so nothing
   * changed. The one exception is no answer at all, where the call may have
   * landed before the connection dropped.
   */
  function deactRaisedText(message: string): string {
    if (/admin_forbidden/.test(message)) {
      return 'This admin seat cannot deactivate logins. It takes a superadmin seat. Nothing changed.';
    }
    if (/JWT/i.test(message)) return 'Your session has ended. Sign in again, then retry. Nothing changed.';
    if (/invalid input syntax for type uuid/i.test(message)) {
      return 'That login id could not be read. Reload and try again. Nothing changed.';
    }
    if (/PGRST202|Could not find the function/i.test(message)) {
      return 'This backend does not have the deactivation function. Nothing changed.';
    }
    // partner_accounts_lifecycle_guard: a session or grant landed mid-call.
    if (/the grants, the sessions and the sign-in ban/.test(message)) {
      return 'The login changed while it was being deactivated (a new session or grant landed at the same moment), so the whole step was rolled back and nothing changed. Try again.';
    }
    if (/Failed to fetch|NetworkError|Load failed|FetchError/i.test(message)) {
      return 'No answer came back from the server. Reload the page and check this row before trying again.';
    }
    return `Deactivation failed (${message}). Nothing changed.`;
  }

  function closeDeactivate(): void {
    deactTarget = null;
    show('deact-overlay', false);
  }

  // Step one of two: every consequence, before anything happens.
  function openDeactivate(p: PartnerRow): void {
    deactTarget = p;
    show('ad-partners-note', false);
    el('deact-title').textContent = `Deactivate ${loginName(p)}?`;
    el('deact-sub').textContent = [
      p.contact_email,
      p.brand_name,
      roleLabel(p.role),
      p.status === 'suspended' ? 'Suspended' : 'Active',
    ]
      .filter(Boolean)
      .join(' · ');
    const warning = el('deact-warning');
    const text = lastAdminWarning(p);
    warning.textContent = text ?? '';
    warning.hidden = text === null;
    const note = el<HTMLInputElement>('deact-note');
    note.value = '';
    show('deact-error', false);
    show('deact-overlay', true);
    note.focus();
  }

  // Where the decision on this queue entry would actually land (Decision
  // 6.142). admin_partner_review_queue asks partner_notification_recipients
  // for the two BRAND events, so this is the resolved answer, not the stored
  // intent: the address chain followed and the master ANDed in. An EMPTY
  // recipients list with a named suppression is the case worth seeing before
  // clicking, so it is called out rather than left blank.
  const ROUTE_LABEL: Record<string, string> = {
    draft_approved: 'Approve',
    draft_changes_requested: 'Request changes',
  };
  const SUPPRESS_TEXT: Record<string, string> = {
    notifications_disabled: 'notifications are off entirely at that level',
    event_switch_off: 'this notice is switched off',
    no_address: 'no address resolves',
    venue_retired: 'the venue is closed',
    venue_archived: 'the venue is archived',
  };
  const SOURCE_TEXT: Record<string, string> = {
    venue_override: "the venue's own address",
    brand_override: "the brand's address",
    brand_login: 'a brand login sign-in address',
  };
  const ROUTE_STATUS_TEXT: Record<string, string> = {
    unknown_event: 'this event is not in the routing vocabulary',
    unknown_brand: 'the brand could not be resolved',
    venue_required: 'this event needs a venue and none was given',
    venue_not_applicable: 'this event is brand-shaped and was given a venue',
    unknown_venue: 'the venue could not be resolved',
    venue_brand_mismatch: 'the venue belongs to another brand',
  };

  function routing(entry: Record<string, any>): string {
    const routes = (entry.notification_routing ?? {}) as Record<string, any>;
    const settings = (entry.brand_settings ?? null) as Record<string, any> | null;
    const rows = Object.keys(ROUTE_LABEL).map((event) => {
      const r = (routes[event] ?? {}) as Record<string, any>;
      const status = String(r.status ?? 'missing');
      const recipients = (r.recipients ?? []) as Array<Record<string, any>>;
      const suppressed = (r.suppressed ?? []) as Array<Record<string, any>>;
      const why = suppressed
        .map((s) => `${esc(s.scope)}: ${esc(SUPPRESS_TEXT[String(s.reason)] ?? String(s.reason).replaceAll('_', ' '))}`)
        .join(' · ');
      if (status !== 'ok') {
        return `<tr class="bg-rose-50"><td class="py-1 pr-3 text-xs uppercase tracking-wide text-slate-500">${esc(ROUTE_LABEL[event])}</td>
          <td class="py-1 text-rose-800">Not routable: ${esc(ROUTE_STATUS_TEXT[status] ?? status)}</td></tr>`;
      }
      if (recipients.length === 0) {
        return `<tr class="bg-amber-50"><td class="py-1 pr-3 text-xs uppercase tracking-wide text-slate-500">${esc(ROUTE_LABEL[event])}</td>
          <td class="py-1 text-amber-900">Nobody would be mailed${why ? ` (${why})` : ''}.</td></tr>`;
      }
      const who = recipients
        .map((x) => `${esc(x.address)} <span class="text-xs text-slate-500">(${esc(x.scope)}, ${esc(SOURCE_TEXT[String(x.source)] ?? String(x.source))})</span>`)
        .join('<br />');
      return `<tr><td class="py-1 pr-3 align-top text-xs uppercase tracking-wide text-slate-500">${esc(ROUTE_LABEL[event])}</td>
        <td class="py-1">${who}${why ? `<span class="block text-xs text-slate-500">also: ${why}</span>` : ''}</td></tr>`;
    });
    const intent = settings
      ? `Stored intent: master ${settings.notifications_enabled ? 'on' : 'off'} · approved ${settings.notify_draft_approved ? 'on' : 'off'} · changes ${settings.notify_draft_changes_requested ? 'on' : 'off'} · address ${settings.contact_email ? esc(settings.contact_email) : 'none set, so it inherits'}`
      : 'Stored intent unavailable.';
    return `<div class="mt-4 rounded-md border border-slate-200 bg-slate-50 p-3">
      <p class="text-xs uppercase tracking-wide text-slate-500">Where your decision lands</p>
      <table class="mt-2 w-full text-sm"><tbody>${rows.join('')}</tbody></table>
      <p class="mt-2 text-xs text-slate-500">${intent}</p>
    </div>`;
  }

  // One queue entry is the brand's single draft (Decision 6.138): the brand
  // section (applied only when brand_touched), the logo, and a `locations`
  // array whose entries edit a live venue (kind 'edit') or add one ('new').
  function draftCard(entry: Record<string, any>): HTMLElement {
    const d = entry.draft;
    const live = entry.live ?? {};
    const card = document.createElement('div');
    card.className = 'rounded-lg border border-slate-200 bg-white p-5';
    const perks = (d.perks as Array<Record<string, any>>) ?? [];
    const dot = '<span class="text-slate-300">·</span>';
    const cell = (v: unknown) => (v == null || v === '' ? dot : esc(v));
    const row = (label: string, liveVal: unknown, draftVal: unknown) => {
      const changed = String(liveVal ?? '') !== String(draftVal ?? '');
      return `<tr class="${changed ? 'bg-amber-50' : ''}">
        <td class="py-1 pr-3 text-xs uppercase tracking-wide text-slate-500">${label}</td>
        <td class="py-1 pr-3 text-slate-500">${cell(liveVal)}</td>
        <td class="py-1 font-medium">${cell(draftVal)}</td></tr>`;
    };
    const perkTitles = (list: Array<Record<string, any>>) => list.map((p) => p.title).join(' · ');
    const pin = (e: Record<string, any>) => (e.latitude != null ? `${e.latitude}, ${e.longitude}` : null);
    const table = (rows: string[]) => `
      <table class="mt-2 w-full text-sm">
        <thead><tr class="text-left text-xs uppercase tracking-wide text-slate-400">
          <th class="pr-3"></th><th class="pr-3 font-medium">Live</th><th class="font-medium">Draft</th></tr></thead>
        <tbody>${rows.join('')}</tbody>
      </table>`;

    const brandBlock = d.brand_touched
      ? table([
          row('Name', live.name, d.business_name),
          row('Website', live.website_url, d.website_url),
          row('Perks (every location)', perkTitles(entry.live_perks ?? []), perkTitles(perks)),
        ])
      : '<p class="mt-2 text-sm text-slate-500">Brand fields unchanged</p>';

    const locations = (entry.locations ?? []) as Array<Record<string, any>>;
    const locationBlocks = locations.map((loc) => {
      const e = (loc.draft ?? {}) as Record<string, any>;
      const lv = (loc.live ?? {}) as Record<string, any>;
      if (loc.kind === 'edit') {
        return `<div class="mt-3 rounded-md border border-slate-200 p-3">
          <p class="text-sm font-semibold">Edit · <span class="font-mono">${esc(lv.code ?? '')}</span></p>
          ${table([
            row('Label', lv.partner_label, e.label),
            row('Address', lv.partner_address, e.address),
            row('Pin', lv.partner_location ? 'set' : '', pin(e) ?? 'kept'),
            row('Perks (this location)', perkTitles(loc.live_perks ?? []), perkTitles(e.perks ?? [])),
          ])}
        </div>`;
      }
      const newRow = (label: string, v: unknown) => `<tr>
        <td class="py-1 pr-3 text-xs uppercase tracking-wide text-slate-500">${label}</td>
        <td class="py-1 font-medium">${cell(v)}</td></tr>`;
      return `<div class="mt-3 rounded-md border border-emerald-200 bg-emerald-50/40 p-3">
        <p class="text-sm font-semibold">New venue</p>
        <table class="mt-2 w-full text-sm"><tbody>
          ${newRow('Label', e.label)}
          ${newRow('Address', e.address)}
          ${newRow('Pin', pin(e))}
          ${newRow('Perks (this location)', perkTitles(e.perks ?? []))}
        </tbody></table>
      </div>`;
    });
    const locationsBlock = locations.length > 0
      ? `<h3 class="mt-4 text-xs uppercase tracking-wide text-slate-500">Locations (${locations.length})</h3>${locationBlocks.join('')}`
      : '<p class="mt-3 text-sm text-slate-500">No location changes</p>';

    const routingBlock = routing(entry);

    card.innerHTML = `
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold">Brand · ${esc(live.name ?? d.business_name ?? '')}</p>
          <p class="text-xs text-slate-500">${esc(entry.account?.contact_name ?? '')} · ${esc(entry.account?.contact_email ?? '')} · submitted ${new Date(d.updated_at).toLocaleString()}</p>
        </div>
        ${entry.logo_url ? `<img src="${esc(entry.logo_url)}" alt="" class="h-14 w-14 rounded-full border border-slate-200 object-cover" />` : ''}
      </div>
      ${brandBlock}
      ${locationsBlock}
      ${routingBlock}
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <input data-note class="w-64 rounded-md border border-slate-300 px-3 py-1.5 text-sm" placeholder="Note to the partner (required to request changes)" />
        <button data-approve class="rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-emerald-500">Approve</button>
        <button data-changes class="rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100">Request changes</button>
      </div>`;
    const note = card.querySelector('[data-note]') as HTMLInputElement;
    card.querySelector('[data-approve]')!.addEventListener('click', async () => {
      const res = await callFnJson<Record<string, any>>('admin_approve_partner_draft', {
        draft_id: d.id,
        note: note.value || undefined,
      }).catch((err): Record<string, any> => ({ status: String(err) }));
      if (res.status === 'ok') {
        const created = (res.created_locations ?? []) as Array<Record<string, any>>;
        toast(
          created.length > 0
            ? `Approved and live. ${created.length} new venue${created.length === 1 ? '' : 's'}: ${created.map((c) => c.code).join(', ')}.`
            : 'Approved and live.',
        );
        card.remove();
      } else {
        toast(`Approve failed (${res.status ?? JSON.stringify(res)}).`);
      }
    });
    card.querySelector('[data-changes]')!.addEventListener('click', async () => {
      if (!note.value.trim()) {
        toast('Write the partner a note first.');
        return;
      }
      const res = await rpc<Record<string, any>>('request_partner_draft_changes', {
        p_draft_id: d.id,
        p_note: note.value,
      });
      if (res.status === 'ok') {
        toast('Sent back with your note.');
        card.remove();
      } else {
        toast(`Could not send (${res.status}).`);
      }
    });
    return card;
  }

  // Leads from the PUBLIC /register form (Decision 6.134). Unauthenticated
  // input, so every field is set via textContent, never innerHTML.
  async function loadInquiries(): Promise<void> {
    const res = await rpc<Record<string, any>>('get_partner_inquiries_admin', {});
    if (res.status !== 'ok') return; // forbidden for non-superadmin seats; hide quietly
    const rows = (res.inquiries ?? []) as Array<Record<string, any>>;
    show('ad-inquiries-empty', rows.length === 0);
    const tbody = el('ad-inquiries');
    tbody.innerHTML = '';
    for (const q of rows) {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100' + (q.status === 'closed' ? ' text-slate-400' : '');
      const cell = (text: string, cls = 'py-2 pr-4') => {
        const td = document.createElement('td');
        td.className = cls;
        td.textContent = text;
        return td;
      };
      tr.appendChild(cell(q.business_name ?? ''));
      const contact = cell(q.contact_name ?? '');
      const emailLine = document.createElement('a');
      emailLine.className = 'block text-xs text-slate-500 underline';
      emailLine.href = `mailto:${encodeURIComponent(q.email ?? '')}`;
      emailLine.textContent = q.email ?? '';
      contact.appendChild(emailLine);
      tr.appendChild(contact);
      tr.appendChild(cell(q.phone ?? ''));
      tr.appendChild(cell(fmtDate(q.created_at)));
      tr.appendChild(cell(q.status ?? ''));

      const actions = document.createElement('td');
      actions.className = 'py-2 space-x-2';
      const move = (label: string, to: string) => {
        const btn = document.createElement('button');
        btn.textContent = label;
        btn.className = 'rounded-md border border-slate-300 px-2 py-1 text-xs hover:bg-slate-100';
        btn.addEventListener('click', async () => {
          const res2 = await rpc<Record<string, any>>('set_partner_inquiry_status', {
            p_inquiry_id: q.id,
            p_status: to,
          }).catch((err) => ({ status: String(err) }));
          if (res2.status === 'ok') {
            toast(to === 'contacted' ? 'Marked contacted.' : to === 'closed' ? 'Closed.' : 'Reopened.');
            await loadInquiries();
          } else {
            toast(`Failed (${res2.status}).`);
          }
        });
        return btn;
      };
      if (q.status === 'new') actions.appendChild(move('Mark contacted', 'contacted'));
      if (q.status !== 'closed') actions.appendChild(move('Close', 'closed'));
      if (q.status === 'closed') actions.appendChild(move('Reopen', 'new'));
      tr.appendChild(actions);
      tbody.appendChild(tr);
    }
  }

  async function load(): Promise<void> {
    const res = await callFn('admin_partner_review_queue', {});
    show('ad-loading', false);
    if (res.status === 403) {
      show('ad-denied', true);
      return;
    }
    const body = await res.json();
    if (body.status !== 'ok') {
      show('ad-denied', true);
      return;
    }
    show('ad-body', true);

    const queue = body.queue as Array<Record<string, any>>;
    show('ad-queue-empty', queue.length === 0);
    const queueNode = el('ad-queue');
    queueNode.innerHTML = '';
    for (const entry of queue) queueNode.appendChild(draftCard(entry));

    const partners = el('ad-partners');
    partners.innerHTML = '';
    show('ad-partners-note', false);
    partnerRows = body.partners as PartnerRow[];
    for (const p of partnerRows) {
      // Decision 6.152: 'deactivated' is terminal, so the row carries a badge
      // instead of Suspend / Reactivate, greyed like a closed inquiry.
      const deactivated = p.status === 'deactivated';
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100' + (deactivated ? ' text-slate-400' : '');
      const mark = (ok: boolean) => (ok ? '✓' : '·');
      const statusCell = deactivated
        ? `<span class="rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-medium text-slate-700">${DEACTIVATED_BADGE_TEXT}</span>`
        : esc(p.status);
      tr.innerHTML = `
        <td class="py-2 pr-4"><span class="font-mono">${esc(p.code ?? '')}</span> <span class="text-xs text-slate-500">${esc(p.brand_name ?? '')}</span></td>
        <td class="py-2 pr-4">${esc(p.contact_name)} <span class="text-xs text-slate-500">${esc(p.contact_email)}</span></td>
        <td class="py-2 pr-4">${statusCell}</td>
        <td class="py-2 pr-4">${mark(p.agreements.terms)}</td>
        <td class="py-2 pr-4">${mark(p.agreements.brand_license)}</td>
        <td class="py-2 pr-4">${mark(p.agreements.content_policy)}</td>`;
      const actions = document.createElement('td');
      actions.className = 'py-2 space-x-2 whitespace-nowrap';
      if (!deactivated) {
        const flip = document.createElement('button');
        const suspending = p.status === 'active';
        flip.textContent = suspending ? 'Suspend' : 'Reactivate';
        flip.className = 'rounded-md border border-slate-300 px-2 py-1 text-xs hover:bg-slate-100';
        flip.addEventListener('click', async () => {
          const res2 = await callFnJson<Record<string, any>>('admin_set_partner_status', {
            partner_account_id: p.id,
            status: suspending ? 'suspended' : 'active',
          }).catch((err: unknown) => ({ status: err instanceof Error ? err.message : String(err) }));
          if (res2.status === 'ok') {
            toast(suspending ? 'Suspended (sessions revoked).' : 'Reactivated.');
            await load();
          } else if (res2.status === 'deactivated') {
            // The 409 admin_set_partner_status answers for a deactivated login:
            // it was closed after this page loaded.
            toast('That login has been deactivated, so it can no longer be suspended or reactivated.');
            await load();
          } else {
            toast(`Failed (${res2.status}).`);
          }
        });
        actions.appendChild(flip);

        const deactivate = document.createElement('button');
        deactivate.textContent = 'Deactivate';
        deactivate.className = 'rounded-md border border-rose-200 bg-white px-2 py-1 text-xs text-rose-700 hover:bg-rose-50';
        deactivate.addEventListener('click', () => openDeactivate(p));
        actions.appendChild(deactivate);
      }
      tr.appendChild(actions);
      partners.appendChild(tr);
    }

    const unpub = body.unpublished as Array<Record<string, any>>;
    show('ad-unpub-empty', unpub.length === 0);
    const unpubNode = el('ad-unpub');
    unpubNode.innerHTML = '';
    for (const u of unpub) {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between rounded-md border border-slate-200 bg-white px-4 py-2.5';
      const name = document.createElement('span');
      name.textContent = u.name ?? '';
      li.appendChild(name);
      const btn = document.createElement('button');
      btn.textContent = 'Republish';
      btn.className = 'rounded-md border border-slate-300 px-2 py-1 text-xs hover:bg-slate-100';
      btn.addEventListener('click', async () => {
        const res2 = await rpc<Record<string, any>>('set_partner_listing_published', {
          p_brand_id: u.id,
          p_published: true,
        });
        toast(res2.status === 'ok' ? 'Republished.' : `Failed (${res2.status}).`);
        await load();
      });
      li.appendChild(btn);
      unpubNode.appendChild(li);
    }

    await loadInquiries();

    const metrics = await rpc<Record<string, any>>('get_partner_metrics_admin', {});
    if (metrics.status === 'ok') {
      el('ad-metrics').innerHTML = (metrics.partners as Array<Record<string, any>>)
        .filter(Boolean)
        .map((m) => `<tr class="border-b border-slate-100">
          <td class="py-2 pr-4 font-mono">${m.code}</td>
          <td class="py-2 pr-4">${m.totals.scans_period}</td>
          <td class="py-2 pr-4">${m.totals.scans_all_time}</td>
          <td class="py-2 pr-4">${m.totals.redemptions_all_time}</td>
          <td class="py-2">${m.totals.new_user_redemptions}</td></tr>`)
        .join('');
    }
  }

  el<HTMLFormElement>('ad-agreement-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const res = await callFnJson<Record<string, any>>('admin_publish_agreement', {
      kind: el<HTMLSelectElement>('ag-kind').value,
      version: el<HTMLInputElement>('ag-version').value.trim(),
      body_text: el<HTMLTextAreaElement>('ag-body').value,
    }).catch((err) => ({ status: String(err) }));
    if (res.status === 'ok') {
      toast('Published. Every partner re-accepts at next sign-in.');
      el<HTMLInputElement>('ag-version').value = '';
      el<HTMLTextAreaElement>('ag-body').value = '';
    } else {
      toast(`Publish failed (${res.status ?? JSON.stringify(res)}).`);
    }
  });

  el('deact-cancel').addEventListener('click', closeDeactivate);
  el('deact-overlay').addEventListener('click', (e) => {
    if (e.target === el('deact-overlay')) closeDeactivate();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !el('deact-overlay').hidden) closeDeactivate();
  });

  // Step two of two, then the one call. p_partner_account_id and p_note are the
  // two parameters admin_deactivate_partner_login defines (migration
  // 20260922000000); the note lands in the admin audit row.
  el('deact-go').addEventListener('click', async () => {
    if (!deactTarget) return;
    const target = deactTarget;
    const name = loginName(target);
    if (!confirm(`Deactivate ${name} for good? Sign-in and every session end now, and this cannot be undone.`)) return;
    const go = el<HTMLButtonElement>('deact-go');
    go.disabled = true;
    show('deact-error', false);
    const note = el<HTMLInputElement>('deact-note').value.trim();
    const res = await rpc<Record<string, any>>('admin_deactivate_partner_login', {
      p_partner_account_id: target.id,
      p_note: note === '' ? null : note,
    }).catch((err: unknown): Record<string, any> => ({
      status: 'raised',
      message: (err instanceof Error ? err.message : String(err)).replace(/^admin_deactivate_partner_login: /, ''),
    }));
    go.disabled = false;
    if (res.status === 'raised') {
      // The panel is still up, so the reason belongs inside it.
      const error = el('deact-error');
      error.textContent = deactRaisedText(String(res.message ?? ''));
      error.hidden = false;
      return;
    }
    closeDeactivate();
    if (res.status === 'ok') {
      const kept = Number(res.acceptances_kept ?? 0);
      toast(
        `${name} is deactivated. Sign-in and every session ended, and ${kept} agreement acceptance record${kept === 1 ? ' was' : 's were'} kept.`,
      );
    } else {
      toast(DEACT_STATUS_TEXT[String(res.status)] ?? `Deactivation did not go through (${res.status}). The list is refreshed.`);
    }
    await load();
    if (res.status === 'ok' && res.brand_has_active_admin === false) partnersWarning(noAdminLeftText(target));
  });

  void requireSession().then(load).catch((err) => {
    if (String(err).includes('redirecting')) return;
    show('ad-loading', false);
    const node = el('ad-denied');
    node.textContent = `Could not load the review area (${err}). Refresh to retry.`;
    node.hidden = false;
  });
</script>
