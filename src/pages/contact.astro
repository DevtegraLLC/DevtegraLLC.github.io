---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact | Devtegra"
  description="Contact Devtegra, LLC. We appreciate your interest and look forward to hearing from you."
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Contact us</h1>
    <p class="mt-6 leading-relaxed text-slate-600">
      Feel free to contact us with any questions or concerns. We appreciate your
      interest and look forward to hearing from you.
    </p>

    <dl class="mt-10 space-y-8">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Email</dt>
        <dd class="mt-2 text-lg">
          <a href="mailto:contact.us@devtegra.com" class="font-medium text-slate-900 hover:text-indigo-600">contact.us@devtegra.com</a>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Phone</dt>
        <dd class="mt-2 text-lg font-medium text-slate-900">850-499-0700</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Address</dt>
        <dd class="mt-2 text-lg font-medium text-slate-900">
          8315 Liberty Walk Dr<br />Round Rock, TX 78681
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Security reports</dt>
        <dd class="mt-2 text-lg">
          <a href="mailto:security@devtegra.com" class="font-medium text-slate-900 hover:text-indigo-600">security@devtegra.com</a>
          <span class="block mt-1 text-sm text-slate-500">See our <a href="/security" class="text-indigo-600 hover:underline">security page</a> for how to report a vulnerability.</span>
        </dd>
      </div>
    </dl>
  </div>
</Base>
