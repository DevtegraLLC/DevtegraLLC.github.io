---
import Base from '../../layouts/Base.astro';

// Landing for the double opt-in confirmation. The beta_confirm edge function
// flips the row server-side then 302-redirects here with ?status=confirmed|
// expired|invalid. This page is static (GitHub Pages), so it reads the status
// client-side. TEMPORARY (removed at feature teardown).
---

<Base
  title="Confirm your FitCreature beta signup"
  description="Confirm your email to join the FitCreature beta list."
  noindex={true}
>
  <div class="mx-auto max-w-xl px-6 py-20">
    <div id="confirm-confirmed" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 p-8">
      <h1 class="text-2xl font-bold text-emerald-900">You're on the list</h1>
      <p class="mt-3 leading-relaxed text-emerald-800">
        Your email is confirmed. We'll reach out when a FitCreature beta spot opens for you. Thanks for joining early.
      </p>
    </div>

    <div id="confirm-expired" class="hidden rounded-xl border border-amber-200 bg-amber-50 p-8">
      <h1 class="text-2xl font-bold text-amber-900">This link has expired</h1>
      <p class="mt-3 leading-relaxed text-amber-800">
        Confirmation links are good for a few days. Head back and sign up again and we'll send a fresh one.
      </p>
      <p class="mt-5"><a href="/beta" class="font-medium text-indigo-600 hover:underline">Back to signup &rarr;</a></p>
    </div>

    <div id="confirm-invalid" class="hidden rounded-xl border border-slate-200 bg-slate-50 p-8">
      <h1 class="text-2xl font-bold text-slate-900">This link is no longer valid</h1>
      <p class="mt-3 leading-relaxed text-slate-600">
        If you already confirmed, you're all set, nothing more to do. Otherwise, sign up again and we'll send a new link.
      </p>
      <p class="mt-5"><a href="/beta" class="font-medium text-indigo-600 hover:underline">Back to signup &rarr;</a></p>
    </div>
  </div>

  <script is:inline>
    (function () {
      const status = new URLSearchParams(window.location.search).get('status');
      const id =
        status === 'confirmed'
          ? 'confirm-confirmed'
          : status === 'expired'
            ? 'confirm-expired'
            : 'confirm-invalid';
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
    })();
  </script>
</Base>
