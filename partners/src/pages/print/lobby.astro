---
import Portal from '../../layouts/Portal.astro';
---

<Portal title="Lobby sheet" nav={false}>
  <div class="print:hidden mx-auto max-w-md rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-600">
    <p><strong>Lobby sheet (Letter / A4).</strong> A front-desk or notice-board one-pager. Print, then Save as PDF works for shops.</p>
    <p class="mt-2 text-xs text-slate-500">Full-color design: a print shop handles it as-is. On an office printer, enable "Background graphics" in the print dialog.</p>
    <button id="lobby-print" class="mt-3 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white">Print</button>
  </div>

  <div class="sheet mx-auto mt-6">
    <p class="brand">
      <img id="lobby-logo" class="brandimg" alt="FitCreature" hidden />
      <span id="lobby-brandtext"><span class="fit">Fit</span><span class="creature">Creature</span></span>
    </p>
    <p id="lobby-head" class="head"></p>
    <p id="lobby-sub" class="sub"></p>
    <div class="qrcard">
      <div id="lobby-qr" class="qr"></div>
    </div>
    <p class="code">CODE <span id="lobby-code" class="mono"></span></p>
    <p class="hint">Scan with your phone camera, or enter the code inside the FitCreature app.</p>
    <div class="glow one"></div>
    <div class="glow two"></div>
    <div class="glow three"></div>
  </div>
</Portal>

<style>
  .sheet {
    position: relative; overflow: hidden;
    width: 190mm; padding: 24mm 18mm 20mm; text-align: center;
    background: linear-gradient(165deg, #1b1530 0%, #0a0815 70%);
    border-radius: 4mm;
    print-color-adjust: exact; -webkit-print-color-adjust: exact;
  }
  .brand { position: relative; z-index: 1; font-weight: 800; font-size: 26pt; letter-spacing: 0.01em; }
  .fit { color: #ffffff; }
  .creature { color: #f0c040; }
  .head { position: relative; z-index: 1; margin-top: 12mm; font-size: 26pt; font-weight: 800; line-height: 1.15; color: #ffffff; }
  .sub { position: relative; z-index: 1; margin-top: 5mm; font-size: 13.5pt; color: #c0c1ff; }
  .qrcard {
    position: relative; z-index: 1;
    margin: 12mm auto 0; width: 100mm; padding: 5mm;
    background: #ffffff; border-radius: 4mm;
    box-shadow: 0 0 0 1.5mm rgba(240, 192, 64, 0.9);
  }
  .qr :global(svg) { display: block; width: 100%; height: auto; }
  .code { position: relative; z-index: 1; margin-top: 9mm; font-size: 12pt; letter-spacing: 0.25em; color: #c0c1ff; }
  .mono { font-family: ui-monospace, monospace; font-weight: 800; font-size: 19pt; letter-spacing: 0.2em; color: #f0c040; }
  .hint { position: relative; z-index: 1; margin-top: 3mm; font-size: 10pt; color: #9d9ab5; }
  .glow { position: absolute; border-radius: 50%; filter: blur(22mm); }
  .glow.one { width: 110mm; height: 110mm; left: -40mm; top: -35mm; background: #6366f1; opacity: 0.55; }
  .glow.two { width: 95mm; height: 95mm; right: -35mm; bottom: -30mm; background: #f0c040; opacity: 0.3; }
  .glow.three { width: 70mm; height: 70mm; right: -20mm; top: 30mm; background: #393b84; opacity: 0.5; }
  .brandimg { display: block; margin: 0 auto; max-width: 110mm; max-height: 22mm; }
  .sheet.bw { background: #ffffff; box-shadow: inset 0 0 0 0.8mm #111111; }
  .sheet.bw .fit, .sheet.bw .creature { color: #111111; }
  .sheet.bw .head { color: #111111; }
  .sheet.bw .sub { color: #333333; }
  .sheet.bw .qrcard { box-shadow: inset 0 0 0 0.6mm #111111; }
  .sheet.bw .code { color: #444444; }
  .sheet.bw .mono { color: #111111; }
  .sheet.bw .hint { color: #666666; }
  .sheet.bw .glow { display: none; }
  @media print {
    :global(header), .print\:hidden { display: none !important; }
    .sheet { margin: 0; border-radius: 0; }
    @page { size: letter portrait; margin: 8mm; }
  }
</style>

<script>
  import { requireSession, callFn, callFnJson, el } from '../../lib/portal';

  const bw = new URLSearchParams(location.search).get('style') === 'bw';
  if (bw) document.querySelector('.sheet')!.classList.add('bw');
  const logo = el<HTMLImageElement>('lobby-logo');
  logo.addEventListener('load', () => {
    logo.hidden = false;
    el('lobby-brandtext').hidden = true;
  });
  logo.src = bw ? '/assets/brand/logos/fc_logo_black.png' : '/assets/brand/logos/fc_logo_white.png';

  void requireSession().then(async () => {
    const manifest = await callFnJson<Record<string, any>>('partner_print_pack', { format: 'manifest' });
    el('lobby-code').textContent = manifest.code;
    el('lobby-head').textContent = manifest.copy[0];
    el('lobby-sub').textContent = manifest.copy[1] ?? '';
    const svgRes = await callFn('partner_print_pack', { variant: 'standard', format: 'svg' });
    el('lobby-qr').innerHTML = await svgRes.text();
  }).catch((err) => {
    if (!String(err).includes('redirecting')) {
      document.querySelector('.sheet')?.insertAdjacentHTML('afterbegin',
        `<p style="color:#e11d48;font-size:12px">Could not load the pack (${err}). Refresh to retry.</p>`);
    }
  });
  document.getElementById('lobby-print')?.addEventListener('click', () => window.print());
</script>
