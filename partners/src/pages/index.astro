---
import Portal from '../layouts/Portal.astro';
---

<Portal title="Sign in" nav={false}>
  <div class="mx-auto mt-16 max-w-sm">
    <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">FitCreature Partners</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">Partner sign-in</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">
      Manage your in-app listing, see how your code is doing, and download your print pack.
    </p>

    <form id="login-form" class="mt-8 space-y-4" novalidate>
      <div>
        <label for="email" class="block text-sm font-medium">Email</label>
        <input id="email" type="email" required autocomplete="email"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium">Password</label>
        <input id="password" type="password" required autocomplete="current-password"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
      </div>
      <p id="login-error" class="text-sm text-rose-600" hidden></p>
      <button type="submit" id="login-submit"
        class="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50">
        Sign in
      </button>
    </form>

    <div class="mt-6 text-sm text-slate-500">
      <button id="reset-link" class="underline hover:text-slate-700">Forgot your password?</button>
      <p id="reset-note" class="mt-2" hidden></p>
    </div>

    <p class="mt-10 text-xs leading-relaxed text-slate-400">
      Partner accounts are set up by the FitCreature team. If you'd like your business in the app,
      reach out via <a class="underline" href="https://devtegra.com/contact">devtegra.com/contact</a>.
    </p>
  </div>
</Portal>

<script>
  import { supabase } from '../lib/supabase';
  import { el, show } from '../lib/portal';

  // Already signed in? Straight to the dashboard.
  void supabase().auth.getSession().then(({ data }) => {
    if (data.session) location.href = '/dashboard';
  });

  el<HTMLFormElement>('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = el<HTMLButtonElement>('login-submit');
    button.disabled = true;
    show('login-error', false);
    const email = el<HTMLInputElement>('email').value.trim();
    const password = el<HTMLInputElement>('password').value;
    const { error } = await supabase().auth.signInWithPassword({ email, password });
    if (error) {
      const node = el('login-error');
      node.textContent = 'That sign-in didn\'t work. Check the email and password and try again.';
      node.hidden = false;
      button.disabled = false;
      return;
    }
    location.href = '/dashboard';
  });

  el('reset-link').addEventListener('click', async () => {
    const email = el<HTMLInputElement>('email').value.trim();
    const note = el('reset-note');
    if (!email) {
      note.textContent = 'Enter your email above first, then tap this again.';
      note.hidden = false;
      return;
    }
    await supabase().auth.resetPasswordForEmail(email, {
      redirectTo: `${location.origin}/account?recovery=1`,
    });
    note.textContent = 'If that address has a partner account, a reset link is on its way.';
    note.hidden = false;
  });
</script>
