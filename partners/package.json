{
  "name": "fitcreature-partner-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "rm -rf public/assets && mkdir -p public/assets && cp -R ../public/brand public/assets/brand",
    "dev": "npm run sync-assets && astro dev --port 4322",
    "build": "npm run sync-assets && astro build",
    "preview": "astro preview",
    "test": "npm run build && node tests/portal.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.10.0",
    "tailwindcss": "^4.1.0"
  }
}
