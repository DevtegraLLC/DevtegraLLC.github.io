---
import Portal from '../layouts/Portal.astro';
---

<Portal title="Print pack">
  <h1 class="text-2xl font-bold tracking-tight">Print pack</h1>
  <p class="mt-2 text-sm text-slate-600">
    Everything a print shop needs: your QR at print resolution, your code for manual entry, and copy you can use as-is.
  </p>

  <p id="pp-loading" class="mt-6 text-sm text-slate-500">Loading…</p>
  <div id="pp-gate" hidden class="mt-6 rounded-lg border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-900">
    The print pack opens once the current agreements are accepted — see the <a class="underline" href="/dashboard">Overview</a> page.
  </div>

  <div id="pp-body" hidden>
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
      <p class="text-xs uppercase tracking-wide text-slate-500">Your code</p>
      <p id="pp-code" class="mt-1 font-mono text-3xl font-bold tracking-widest"></p>
      <p class="mt-1 text-sm text-slate-600">
        Scans open <span id="pp-url" class="font-mono"></span> — the code doubles as the manual-entry fallback in the app.
      </p>
    </div>

    <h2 class="mt-8 text-sm font-semibold">QR files</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h3 class="font-semibold">Standard (square)</h3>
        <p class="mt-1 text-sm text-slate-600">SVG for print shops, PNG for digital.</p>
        <div class="mt-3 flex gap-2">
          <button data-dl="standard.svg" class="pp-dl rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100">SVG</button>
          <button data-dl="standard.png" class="pp-dl rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100">PNG</button>
        </div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h3 class="font-semibold">Circular (stickers)</h3>
        <p class="mt-1 text-sm text-slate-600">Borderless die-cut variant. Keep it at least <span id="pp-mindia"></span> mm across, dark on light, matte.</p>
        <div class="mt-3 flex gap-2">
          <button data-dl="circle.svg" class="pp-dl rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100">SVG</button>
          <button data-dl="circle.png" class="pp-dl rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100">PNG</button>
        </div>
      </div>
    </div>

    <h2 class="mt-8 text-sm font-semibold">Ready-to-print layouts</h2>
    <p class="mt-1 text-sm text-slate-600">Open, then print or save as PDF from your browser.</p>
    <div class="mt-3 flex gap-3">
      <a href="/print/tent" target="_blank" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100">Table tent</a>
      <a href="/print/lobby" target="_blank" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-100">Lobby sheet</a>
    </div>

    <h2 class="mt-8 text-sm font-semibold">Copy you can use as-is</h2>
    <ul id="pp-copy" class="mt-2 space-y-2 text-sm"></ul>

    <h2 id="logo-spec" class="mt-10 text-sm font-semibold">Logo spec + safe area</h2>
    <div class="mt-3 grid items-start gap-6 sm:grid-cols-[12rem_1fr]">
      <svg viewBox="0 0 200 200" class="w-48 rounded-lg border border-slate-200 bg-white" aria-label="Logo safe-area diagram">
        <rect x="10" y="10" width="180" height="180" fill="#f8fafc" stroke="#cbd5e1" stroke-dasharray="4 3"/>
        <circle cx="100" cy="100" r="90" fill="#eef2ff" stroke="#6366f1"/>
        <circle cx="100" cy="100" r="64" fill="none" stroke="#6366f1" stroke-dasharray="4 3"/>
        <text x="100" y="97" text-anchor="middle" font-size="11" fill="#3730a3">keep your mark</text>
        <text x="100" y="111" text-anchor="middle" font-size="11" fill="#3730a3">inside this circle</text>
        <text x="100" y="192" text-anchor="middle" font-size="9" fill="#64748b">square file · corners get cropped</text>
      </svg>
      <ul class="list-disc space-y-1 pl-5 text-sm text-slate-600">
        <li>Square PNG, JPEG, or WebP; 120-1024 px per side (512×512 is a good target).</li>
        <li>The app shows it cropped to a circle — keep your mark inside the inscribed circle; corners are cut.</li>
        <li>Under 1.5 MB; we re-process every upload and strip all embedded metadata.</li>
        <li>No animation, no SVG files.</li>
      </ul>
    </div>
  </div>
</Portal>

<script>
  import { requireSession, callFn, callFnJson, el, show, saveBlob, toast } from '../lib/portal';

  let code = '';

  async function load(): Promise<void> {
    const res = await callFn('partner_print_pack', { format: 'manifest' });
    const body = await res.json().catch(() => ({}));
    show('pp-loading', false);
    if (res.status === 403 && body.error === 'agreements_required') {
      show('pp-gate', true);
      return;
    }
    if (!res.ok || body.status !== 'ok') {
      toast(`Could not load the pack (${body.error ?? res.status}).`);
      return;
    }
    code = body.code;
    el('pp-code').textContent = body.code;
    el('pp-url').textContent = body.join_url;
    el('pp-mindia').textContent = String(body.min_circle_diameter_mm);
    el('pp-copy').innerHTML = (body.copy as string[])
      .map((c) => `<li class="rounded-md bg-white px-4 py-2.5 border border-slate-200">“${c}”</li>`)
      .join('');
    show('pp-body', true);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.pp-dl')) {
    button.addEventListener('click', async () => {
      const [variant, format] = button.dataset.dl!.split('.');
      button.disabled = true;
      try {
        const res = await callFn('partner_print_pack', { variant, format });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          toast(`Download failed (${err.error ?? res.status}).`);
          return;
        }
        const blob = await res.blob();
        saveBlob(blob, `fitcreature_qr_${code}${variant === 'circle' ? '_circle' : ''}.${format}`);
      } finally {
        button.disabled = false;
      }
    });
  }

  void requireSession().then(load).catch((err) => {
    if (!String(err).includes('redirecting')) {
      show('pp-loading', false);
      toast(String(err));
    }
  });
</script>
