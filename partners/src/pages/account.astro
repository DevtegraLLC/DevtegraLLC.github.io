---
import Portal from '../layouts/Portal.astro';
---

<Portal title="Account">
  <h1 class="text-2xl font-bold tracking-tight">Account</h1>
  <p id="acct-email" class="mt-2 text-sm text-slate-600"></p>

  <section class="mt-8 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold">Change password</h2>
    <form id="pw-form" class="mt-3 flex max-w-sm flex-col gap-3">
      <input id="pw-new" type="password" autocomplete="new-password" placeholder="New password (10+ characters)"
        class="rounded-md border border-slate-300 px-3 py-2 text-sm" />
      <button class="self-start rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
        Update password
      </button>
    </form>
  </section>

  <section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold">Change contact email</h2>
    <p class="mt-1 text-xs text-slate-500">A confirmation link goes to the new address before the change takes effect.</p>
    <form id="email-form" class="mt-3 flex max-w-sm flex-col gap-3">
      <input id="email-new" type="email" autocomplete="email" placeholder="new@address.example"
        class="rounded-md border border-slate-300 px-3 py-2 text-sm" />
      <button class="self-start rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
        Send confirmation
      </button>
    </form>
  </section>

  <section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold">Extra sign-in security (authenticator app)</h2>
    <div id="mfa-off">
      <p class="mt-1 text-sm text-slate-600">Add a one-time code from an authenticator app to each sign-in.</p>
      <button id="mfa-enroll" class="mt-3 rounded-md border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100">
        Set up
      </button>
    </div>
    <div id="mfa-setup" hidden>
      <p class="mt-1 text-sm text-slate-600">Scan this with your authenticator app, then enter the 6-digit code.</p>
      <div id="mfa-qr" class="mt-3 w-40"></div>
      <form id="mfa-verify-form" class="mt-3 flex max-w-sm gap-2">
        <input id="mfa-code" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456"
          class="w-28 rounded-md border border-slate-300 px-3 py-2 text-center font-mono text-sm" />
        <button class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">Verify</button>
      </form>
    </div>
    <p id="mfa-on" hidden class="mt-1 text-sm text-emerald-700">Authenticator codes are on for this account.</p>
  </section>

  <section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold">Your signed agreements</h2>
    <p class="mt-1 text-xs text-slate-500">Every version you've accepted, retrievable any time.</p>
    <ul id="acct-agreements" class="mt-3 space-y-2 text-sm"></ul>
  </section>
</Portal>

<script>
  import { supabase } from '../lib/supabase';
  import { requireSession, rpc, callFnJson, el, show, toast } from '../lib/portal';

  async function loadAgreements(): Promise<void> {
    const history = await rpc<Record<string, any>>('get_my_agreement_acceptances');
    if (history.status !== 'ok') return;
    const list = el('acct-agreements');
    list.innerHTML = '';
    for (const a of history.acceptances as Array<Record<string, any>>) {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between gap-3 rounded-md border border-slate-200 px-4 py-2.5';
      li.innerHTML = `<span>${String(a.kind).replaceAll('_', ' ')} v${a.version}
          <span class="text-xs text-slate-500">accepted ${new Date(a.accepted_at).toLocaleDateString()}</span></span>`;
      const dl = document.createElement('button');
      dl.textContent = 'Download';
      dl.className = 'rounded-md border border-slate-300 px-3 py-1 text-xs hover:bg-slate-100';
      dl.addEventListener('click', async () => {
        try {
          const res = await callFnJson<{ url: string }>('partner_download_agreement', {
            agreement_version_id: a.agreement_version_id,
          });
          window.open(res.url, '_blank', 'noopener');
        } catch (err) {
          toast(`Could not fetch the document (${err}).`);
        }
      });
      li.appendChild(dl);
      list.appendChild(li);
    }
  }

  async function loadMfa(): Promise<void> {
    const { data } = await supabase().auth.mfa.listFactors();
    const verified = data?.totp?.some((f) => f.status === 'verified') ?? false;
    show('mfa-on', verified);
    show('mfa-off', !verified);
  }

  void requireSession().then(async (session) => {
    el('acct-email').textContent = `Signed in as ${session.user.email}`;
    await Promise.all([loadAgreements(), loadMfa()]);
  }).catch(() => {});

  el<HTMLFormElement>('pw-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = el<HTMLInputElement>('pw-new').value;
    if (password.length < 10) {
      toast('Use at least 10 characters.');
      return;
    }
    const { error } = await supabase().auth.updateUser({ password });
    toast(error ? `Could not update (${error.message}).` : 'Password updated.');
    if (!error) el<HTMLInputElement>('pw-new').value = '';
  });

  el<HTMLFormElement>('email-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = el<HTMLInputElement>('email-new').value.trim();
    if (!email) return;
    const { error } = await supabase().auth.updateUser({ email });
    toast(error ? `Could not start the change (${error.message}).` : 'Confirmation sent to the new address.');
  });

  let factorId = '';
  el('mfa-enroll').addEventListener('click', async () => {
    const { data, error } = await supabase().auth.mfa.enroll({ factorType: 'totp' });
    if (error || !data) {
      toast(`Could not start setup (${error?.message ?? 'unknown'}).`);
      return;
    }
    factorId = data.id;
    el('mfa-qr').innerHTML = data.totp.qr_code;
    show('mfa-off', false);
    show('mfa-setup', true);
  });

  el<HTMLFormElement>('mfa-verify-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = el<HTMLInputElement>('mfa-code').value.trim();
    const challenge = await supabase().auth.mfa.challenge({ factorId });
    if (challenge.error || !challenge.data) {
      toast('Could not verify. Try again.');
      return;
    }
    const verify = await supabase().auth.mfa.verify({ factorId, challengeId: challenge.data.id, code });
    if (verify.error) {
      toast('That code did not match. Try the next one.');
      return;
    }
    show('mfa-setup', false);
    await loadMfa();
    toast('Authenticator codes are on.');
  });
</script>
