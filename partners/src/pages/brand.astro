---
import Portal from '../layouts/Portal.astro';
---

<Portal title="Your brand">
  <h1 class="text-2xl font-bold tracking-tight">Your brand</h1>
  <p class="mt-2 text-sm text-slate-600">
    Your business as it appears on its one card in the app: name, website, logo, and the perks every
    location honors. Per-location details (address, map pin, location-only perks) live under
    <a class="underline" href="/listing">Locations</a>. Changes go to the FitCreature team for review
    before they appear.
  </p>

  <p id="brand-loading" class="mt-4 text-sm text-slate-500">Loading…</p>

  {/* A location manager sees the brand's public identity and cannot change it
      (Decision 6.139): brand-level edits belong to a brand login. */}
  <p id="brand-readonly" hidden class="mt-4 rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-700"></p>

  <div id="status-banner" hidden class="mt-4 rounded-lg border p-4 text-sm"></div>

  <form id="brand-form" hidden class="mt-6 space-y-6">
    <div>
      <label for="f-name" class="block text-sm font-medium">Business name</label>
      <input id="f-name" type="text" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
      <p class="mt-1 text-xs text-slate-500"><span id="c-name"></span> · plain text, no emoji or links · around 4-6 words fits best</p>
    </div>
    <div>
      <label for="f-url" class="block text-sm font-medium">Website</label>
      <input id="f-url" type="url" placeholder="https://…" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
      <p class="mt-1 text-xs text-slate-500"><span id="c-url"></span> · https:// links only</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold">Logo</h2>
      <div class="mt-2 flex items-center gap-4">
        <button type="button" id="logo-circle" aria-label="Upload a logo"
          class="group relative h-20 w-20 shrink-0 overflow-hidden rounded-full border-2 border-dashed border-slate-300 bg-slate-100 hover:border-indigo-400">
          <img id="logo-preview" alt="" class="h-full w-full object-cover" hidden />
          <span id="logo-placeholder" class="absolute inset-0 flex items-center justify-center text-slate-400 group-hover:text-indigo-500">
            <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4m0 0 4 4m-4-4-4 4" /><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
            </svg>
          </span>
        </button>
        <div>
          <button type="button" id="logo-button"
            class="inline-flex items-center gap-2 rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4m0 0 4 4m-4-4-4 4" /><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
            </svg>
            Upload logo
          </button>
          <input id="f-logo" type="file" accept="image/png,image/jpeg,image/webp" hidden />
          <p id="logo-hint" class="mt-2 text-xs text-slate-500">
            Square PNG, JPEG, or WebP · 120-1024px · under 1.5 MB · shown cropped to a circle
            (see the <a class="underline" href="/print-pack#logo-spec">logo spec</a>). One logo for every location.
          </p>
          <p id="logo-note" class="mt-1 text-xs" hidden></p>
        </div>
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold">Perks at every location</h2>
        <button type="button" id="perk-add" class="rounded-md border border-slate-300 px-3 py-1 text-xs hover:bg-slate-100">
          Add perk
        </button>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        Up to <span id="c-maxperks"></span> offers honored at all of your locations. Discount codes: letters and numbers only.
        A perk that only one venue offers belongs on that venue's <a class="underline" href="/listing">location page</a>.
      </p>
      <div id="perk-rows" class="mt-3 space-y-3"></div>
    </div>

    <div id="form-errors" hidden class="rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"></div>

    <div class="flex gap-3">
      <button type="submit" id="btn-save"
        class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
        Save draft
      </button>
      <button type="button" id="btn-submit"
        class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50">
        Submit for review
      </button>
    </div>
  </form>

  {/* Notifications (Decisions 6.141 / 6.142). Brand-admin only on the READ as
      well as the write, so get_my_partner_brand hands a location manager
      `settings: null` and this section stays hidden rather than rendering an
      empty form. */}
  <section id="brand-notify" hidden class="mt-10 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold">Notifications for your brand</h2>
    <p class="mt-1 text-xs text-slate-500">
      Where business notices about your brand go, and which ones you would like. Each location has an
      address and switches of its own under <a class="underline" href="/listing">Locations</a>.
    </p>

    <div class="mt-5">
      <label for="bn-email" class="block text-sm font-medium">Brand notification address</label>
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <input id="bn-email" type="email" autocomplete="off" placeholder="ops@yourgym.example"
          class="w-full max-w-sm rounded-md border border-slate-300 px-3 py-2 text-sm" />
        <button type="button" id="bn-email-save"
          class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
          Save address
        </button>
        <button type="button" id="bn-email-clear" hidden
          class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm hover:bg-slate-100">
          Clear it
        </button>
      </div>
      {/* Never an empty box: the resolved answer and the tier it came from. */}
      <p id="bn-source" class="mt-2 text-sm text-slate-700"></p>
      <p class="mt-1 text-xs text-slate-500">
        A business inbox such as ops@ stays with the business through every staff change. Leaving it
        empty is fine: notices then go to the sign-in address of every active brand login.
      </p>
    </div>

    <div class="mt-6 border-t border-slate-100 pt-5">
      <label for="bn-master" class="flex items-center gap-3 text-sm font-medium">
        <input id="bn-master" type="checkbox" class="h-4 w-4" />
        Send notices addressed to your brand
      </label>
      {/* The genuinely surprising rule, said where someone will look for it. */}
      <p class="mt-1 text-xs text-slate-500">
        Turning this off pauses your brand's own notices. It does not mute your locations: each venue
        keeps its own address and its own switches, so a site manager still hears about their venue.
        The address above is kept either way, and venues that inherit it still do.
      </p>
    </div>

    <div class="mt-6 border-t border-slate-100 pt-5">
      <h3 class="text-sm font-semibold">Notices your brand can receive</h3>
      <div id="bn-events" class="mt-3 space-y-4"></div>
    </div>

    <p id="bn-note" hidden class="mt-5 rounded-lg border p-4 text-sm"></p>
    <p id="bn-updated" class="mt-3 text-xs text-slate-500"></p>
  </section>

  <section id="brand-locations" hidden class="mt-10">
    <h2 class="text-sm font-semibold">Locations on this card</h2>
    <p class="mt-1 text-xs text-slate-500">
      Players see the card near any of these. Each has its own address, map pin, members, and lobby screen.
      You add and edit venues yourself under <a class="underline" href="/listing">Locations</a>; every
      change there rides along in the same submission as this page.
    </p>
    <ul id="brand-location-list" class="mt-3 space-y-2 text-sm"></ul>
  </section>
</Portal>

<script>
  import {
    cacheRole,
    contactSourceText,
    el,
    fmtDateTime,
    mutedEventText,
    type NotifySettings,
    rawSwitch,
    requireSession,
    rpc,
    settingsErrorLines,
    settingsStatusText,
    show,
    STALE_DRAFT_TEXT,
    submitBlockText,
    switchIsLitButOff,
    toast,
  } from '../lib/portal';
  import { authHeaders, functionsUrl } from '../lib/supabase';

  interface Perk {
    title: string | null;
    description: string | null;
    discount_code: string | null;
  }

  let limits: Record<string, number> = {};
  let inReview = false;
  // The draft's concurrency token: null while the brand has no open draft.
  let expectedUpdatedAt: string | null = null;
  // can_edit_brand from the server. Presentation only: the same save is
  // refused with forbidden_brand whatever this page shows.
  let canEdit = true;

  function counter(spanId: string, input: HTMLInputElement, key: string): void {
    const update = () => {
      el(spanId).textContent = `${input.value.length}/${limits[key] ?? '…'} characters`;
    };
    input.oninput = update;
    update();
  }

  function perkRow(perk: Perk = { title: '', description: '', discount_code: '' }): HTMLElement {
    const row = document.createElement('div');
    row.className = 'perk-row grid gap-2 rounded-lg border border-slate-200 bg-white p-3 sm:grid-cols-[1fr_1fr_8rem_auto]';
    row.innerHTML = `
      <input data-k="title" placeholder="Perk title" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
      <input data-k="description" placeholder="Where and how to use it (optional)" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
      <input data-k="discount_code" placeholder="CODE" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm uppercase" />
      <button type="button" class="perk-remove text-sm text-slate-400 hover:text-rose-600">Remove</button>`;
    (row.querySelector('[data-k="title"]') as HTMLInputElement).value = perk.title ?? '';
    (row.querySelector('[data-k="description"]') as HTMLInputElement).value = perk.description ?? '';
    (row.querySelector('[data-k="discount_code"]') as HTMLInputElement).value = perk.discount_code ?? '';
    row.querySelector('.perk-remove')!.addEventListener('click', () => row.remove());
    return row;
  }

  function readPerks(): Perk[] {
    return [...document.querySelectorAll('.perk-row')].map((row) => ({
      title: (row.querySelector('[data-k="title"]') as HTMLInputElement).value || null,
      description: (row.querySelector('[data-k="description"]') as HTMLInputElement).value || null,
      discount_code: (row.querySelector('[data-k="discount_code"]') as HTMLInputElement).value || null,
    }));
  }

  function fields(): Record<string, unknown> {
    return {
      business_name: el<HTMLInputElement>('f-name').value || null,
      website_url: el<HTMLInputElement>('f-url').value || null,
      perks: readPerks(),
    };
  }

  function banner(kind: 'info' | 'warn' | 'good', text: string): void {
    const node = el('status-banner');
    node.hidden = false;
    node.className = `mt-4 rounded-lg border p-4 text-sm ${
      kind === 'warn'
        ? 'border-amber-300 bg-amber-50 text-amber-900'
        : kind === 'good'
          ? 'border-emerald-300 bg-emerald-50 text-emerald-900'
          : 'border-slate-200 bg-white text-slate-700'
    }`;
    node.textContent = text;
  }

  function showErrors(errors: Array<{ field: string; code: string }>): void {
    const node = el('form-errors');
    node.hidden = false;
    node.innerHTML = `<p class="font-semibold">A few things to adjust:</p><ul class="mt-2 list-disc pl-5">${errors
      .map((e) => `<li>${e.field.replaceAll('_', ' ')}: ${e.code.replaceAll('_', ' ')}</li>`)
      .join('')}</ul>`;
  }

  function showPreview(src: string): void {
    const img = el<HTMLImageElement>('logo-preview');
    img.src = src;
    img.hidden = false;
    el('logo-placeholder').hidden = true;
  }

  // The live locations array arrives filtered to what this login reaches
  // (Decision 6.139), so every venue listed here is one it may edit.
  function renderLocations(locations: Array<Record<string, any>>): void {
    const list = el('brand-location-list');
    list.innerHTML = '';
    for (const l of locations) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-4 py-2.5';
      const name = document.createElement('span');
      name.className = 'font-medium';
      name.textContent = l.label ?? l.address ?? 'Unnamed location';
      const meta = document.createElement('span');
      meta.className = 'text-xs text-slate-500';
      const bits = [String(l.code)];
      if (!l.has_location) bits.push('no map pin yet');
      if (l.via === 'granted') bits.push('assigned to your login');
      const perks = Array.isArray(l.perks) ? l.perks.length : 0;
      bits.push(`${perks} location perk${perks === 1 ? '' : 's'}`);
      meta.textContent = bits.join(' · ');
      li.appendChild(name);
      li.appendChild(meta);
      list.appendChild(li);
    }
    show('brand-locations', locations.length > 0);
  }

  /** A location manager reads this page; a brand login edits it. */
  function applyReadOnly(reach: number, brandCount: number): void {
    const note = el('brand-readonly');
    note.textContent =
      `This is your brand's card as players see it, and a brand login makes changes to it. ` +
      `Your login covers ${reach} of the ${brandCount} location${brandCount === 1 ? '' : 's'} on it, ` +
      'editable under Locations.';
    note.hidden = false;
    for (const field of el('brand-form').querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button')) {
      field.disabled = true;
    }
    show('btn-save', false);
    show('btn-submit', false);
    show('perk-add', false);
    show('logo-button', false);
    show('logo-hint', false);
  }

  // -------------------------------------------------------------------------
  // Notifications (Decisions 6.141 / 6.142). Live settings, not part of the
  // draft: every control here acts straight away, so a submission sitting with
  // the review team never holds a notification change up.
  // -------------------------------------------------------------------------

  // The three brand-addressed notices. `key` is the stored column, `event` the
  // name the `effective` block uses; they differ by the notify_ prefix, and the
  // server keys `effective` by EVENT, so both are carried rather than derived
  // in two places.
  const BRAND_EVENTS: Array<{ key: string; event: string; label: string; hint: string }> = [
    {
      key: 'notify_draft_approved',
      event: 'draft_approved',
      label: 'Your submission is approved',
      hint: 'The FitCreature team has published your changes, and your card in the app now shows them.',
    },
    {
      key: 'notify_draft_changes_requested',
      event: 'draft_changes_requested',
      label: 'Your submission needs a change',
      hint: 'The team has sent a submission back with a note about what to adjust.',
    },
    {
      key: 'notify_member_join_request',
      event: 'member_join_request',
      label: 'A copy of the join requests your venues get',
      hint: 'Each venue already hears about its own join requests. This adds a copy to the brand address, and it starts off so a brand with many venues is not flooded.',
    },
  ];

  function notifyNote(kind: 'info' | 'warn' | 'good', text: string): void {
    const node = el('bn-note');
    node.hidden = false;
    node.className = `mt-5 rounded-lg border p-4 text-sm ${
      kind === 'warn'
        ? 'border-amber-300 bg-amber-50 text-amber-900'
        : kind === 'good'
          ? 'border-emerald-300 bg-emerald-50 text-emerald-900'
          : 'border-slate-200 bg-white text-slate-700'
    }`;
    node.textContent = text;
  }

  /**
   * One settings write. Key presence is the instruction, so the patch carries
   * ONLY what changed: an explicit null clears the address, an absent key
   * leaves that field alone. Returns the fresh settings block, or null once the
   * reason has been shown.
   */
  async function writeBrandSettings(patch: Record<string, unknown>): Promise<NotifySettings | null> {
    let res: Record<string, any>;
    try {
      res = await rpc<Record<string, any>>('set_partner_brand_settings', { p: patch });
    } catch {
      notifyNote('warn', 'That did not go through, so nothing changed. Reload the page and try again.');
      return null;
    }
    if (res.status === 'invalid') {
      notifyNote('warn', settingsErrorLines(res.errors).join(' '));
      return null;
    }
    if (res.status !== 'ok') {
      notifyNote('warn', settingsStatusText(res.status));
      return null;
    }
    return (res.settings ?? null) as NotifySettings | null;
  }

  function renderBrandEvents(s: NotifySettings): void {
    const wrap = el('bn-events');
    wrap.innerHTML = '';
    for (const spec of BRAND_EVENTS) {
      const row = document.createElement('div');

      const label = document.createElement('label');
      label.className = 'flex items-start gap-3 text-sm font-medium';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.className = 'mt-0.5 h-4 w-4';
      // The RAW switch, which is what a toggle renders. The master is shown
      // separately rather than folded in, so the switch never lies about what
      // the partner chose.
      box.checked = rawSwitch(s, spec.event);
      box.setAttribute('aria-label', spec.label);
      label.appendChild(box);
      const text = document.createElement('span');
      text.textContent = spec.label;
      label.appendChild(text);
      row.appendChild(label);

      const hint = document.createElement('p');
      hint.className = 'ml-7 mt-1 text-xs text-slate-500';
      hint.textContent = spec.hint;
      row.appendChild(hint);

      // Lit but not sending: the master is off. The switch stays visibly on and
      // says so, with the master control right above it.
      if (switchIsLitButOff(s, spec.event)) {
        const muted = document.createElement('p');
        muted.className = 'ml-7 mt-1 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-900';
        muted.textContent = mutedEventText('brand');
        row.appendChild(muted);
      }

      box.addEventListener('change', async () => {
        const wanted = box.checked;
        box.disabled = true;
        const next = await writeBrandSettings({ [spec.key]: wanted });
        box.disabled = false;
        if (!next) {
          box.checked = !wanted;
          return;
        }
        paintBrandNotify(next);
        notifyNote('good', wanted ? `On: ${spec.label.toLowerCase()}.` : `Off: ${spec.label.toLowerCase()}.`);
      });

      wrap.appendChild(row);
    }
  }

  function paintBrandNotify(s: NotifySettings): void {
    el<HTMLInputElement>('bn-email').value = s.contact_email ?? '';
    show('bn-email-clear', s.contact_email != null);
    el('bn-source').textContent = contactSourceText(s, 'brand');
    el<HTMLInputElement>('bn-master').checked = s.notifications_enabled === true;
    renderBrandEvents(s);
    el('bn-updated').textContent = s.updated_at
      ? `Last changed ${fmtDateTime(s.updated_at)}.`
      : 'Not changed yet, so these are the starting settings.';
  }

  async function saveBrandAddress(value: string | null): Promise<void> {
    const button = el<HTMLButtonElement>('bn-email-save');
    button.disabled = true;
    const next = await writeBrandSettings({ contact_email: value });
    button.disabled = false;
    if (!next) return;
    paintBrandNotify(next);
    notifyNote(
      'good',
      value == null
        ? 'Address cleared. Brand notices follow the fallback now, named below the field.'
        : 'Address saved. Brand notices go there from now on.',
    );
  }

  el('bn-email-save').addEventListener('click', () => {
    const value = el<HTMLInputElement>('bn-email').value.trim();
    void saveBrandAddress(value === '' ? null : value);
  });

  el('bn-email-clear').addEventListener('click', () => void saveBrandAddress(null));

  el<HTMLInputElement>('bn-master').addEventListener('change', async () => {
    const box = el<HTMLInputElement>('bn-master');
    const wanted = box.checked;
    box.disabled = true;
    const next = await writeBrandSettings({ notifications_enabled: wanted });
    box.disabled = false;
    if (!next) {
      box.checked = !wanted;
      return;
    }
    paintBrandNotify(next);
    notifyNote(
      'good',
      wanted
        ? 'Brand notices are on again. Anything switched on below is sending.'
        : 'Brand notices are paused. Your locations are unchanged, and the address above is kept.',
    );
  });

  async function load(): Promise<void> {
    show('brand-loading', true);
    const brand = await rpc<Record<string, any>>('get_my_partner_brand');
    show('brand-loading', false);
    if (brand.status !== 'ok') {
      banner('warn', `Could not load your brand (${brand.status}).`);
      return;
    }
    limits = brand.field_limits ?? {};
    el('c-maxperks').textContent = String(limits.max_perks ?? 5);
    cacheRole(brand.role);
    canEdit = brand.can_edit_brand !== false;

    const live = (brand.live ?? {}) as Record<string, any>;
    const draft = (brand.draft ?? null) as Record<string, any> | null;
    inReview = draft?.status === 'submitted';
    expectedUpdatedAt = (draft?.updated_at as string | undefined) ?? null;

    el<HTMLInputElement>('f-name').value = String(draft?.business_name ?? live.name ?? '');
    el<HTMLInputElement>('f-url').value = String(draft?.website_url ?? live.website_url ?? '');
    const rows = el('perk-rows');
    rows.innerHTML = '';
    for (const perk of ((draft?.perks ?? live.perks ?? []) as Perk[])) rows.appendChild(perkRow(perk));

    const logoPath = draft?.logo_object_path as string | undefined;
    const liveLogo = live.logo_url as string | undefined;
    if (liveLogo && !logoPath) showPreview(liveLogo);
    if (logoPath) {
      const note = el('logo-note');
      note.textContent = 'A new logo is attached to this draft.';
      note.className = 'mt-1 text-xs text-emerald-700';
      note.hidden = false;
    }

    counter('c-name', el<HTMLInputElement>('f-name'), 'business_name');
    counter('c-url', el<HTMLInputElement>('f-url'), 'website_url');

    if (inReview) {
      banner('info', 'Your changes are with the FitCreature team. Editing reopens once the review finishes.');
    } else if (draft?.status === 'changes_requested') {
      banner('warn', `Changes requested: ${draft.review_note ?? 'see the note from the team.'} Edit below and resubmit.`);
    } else if (draft) {
      // One draft per brand (Decision 6.138): location edits made under
      // Locations ride along in the same submission.
      const pending = Array.isArray(draft.locations) ? draft.locations.length : 0;
      banner(
        'info',
        pending > 0
          ? `You have a draft in progress; ${pending} location change${pending === 1 ? '' : 's'} from the Locations page ride along in it. Submit it when it's ready.`
          : "You have a draft in progress. Submit it when it's ready.",
      );
    } else if (live.listing_published === false) {
      banner('warn', 'Your card is not shown in the app right now. Reach out to the FitCreature team if that is unexpected.');
    }

    show('brand-form', true);
    el<HTMLButtonElement>('btn-save').disabled = inReview;
    el<HTMLButtonElement>('btn-submit').disabled = inReview;

    const liveLocations = (live.locations ?? []) as Array<Record<string, any>>;
    renderLocations(liveLocations);
    if (!canEdit) applyReadOnly(liveLocations.length, Number(live.location_count ?? liveLocations.length));

    // Brand settings are brand-admin only on the read too, so a location
    // manager gets `settings: null` and sees no section at all rather than an
    // empty form. can_edit_brand_settings is presentation: the write is
    // refused with forbidden_brand whatever this page shows.
    const settings = (brand.settings ?? null) as NotifySettings | null;
    if (settings && brand.can_edit_brand_settings !== false) {
      paintBrandNotify(settings);
      show('brand-notify', true);
    } else {
      show('brand-notify', false);
    }
  }

  el('perk-add').addEventListener('click', () => {
    if (document.querySelectorAll('.perk-row').length >= (limits.max_perks ?? 5)) {
      toast(`Up to ${limits.max_perks ?? 5} perks.`);
      return;
    }
    el('perk-rows').appendChild(perkRow());
  });

  const openPicker = () => el<HTMLInputElement>('f-logo').click();
  el('logo-button').addEventListener('click', openPicker);
  el('logo-circle').addEventListener('click', openPicker);

  el<HTMLInputElement>('f-logo').addEventListener('change', async () => {
    const input = el<HTMLInputElement>('f-logo');
    const file = input.files?.[0];
    if (!file) return;
    showPreview(URL.createObjectURL(file));
    const note = el('logo-note');
    note.hidden = false;
    note.className = 'mt-1 text-xs text-slate-500';
    note.textContent = 'Uploading…';
    const form = new FormData();
    form.append('file', file);
    // The logo is brand-level: no location rides the URL.
    const res = await fetch(functionsUrl('partner_upload_logo'), {
      method: 'POST',
      headers: await authHeaders(),
      body: form,
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      note.className = 'mt-1 text-xs text-rose-600';
      note.textContent = `That image didn't pass (${body.error ?? res.status}). Square PNG/JPEG/WebP, 120-1024px.`;
      input.value = '';
      return;
    }
    note.className = 'mt-1 text-xs text-emerald-700';
    note.textContent = `Logo attached (${body.width}×${body.height}). It goes live with your next approved submission.`;
  });

  // One draft per brand, so a save carries the token it loaded with. A stale
  // answer deliberately carries no draft body: reload instead of overwriting.
  function staleBanner(): void {
    const node = el('status-banner');
    node.hidden = false;
    node.className = 'mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900';
    node.textContent = `${STALE_DRAFT_TEXT} `;
    const reload = document.createElement('button');
    reload.type = 'button';
    reload.textContent = 'Reload the submission';
    reload.className = 'rounded-md border border-amber-400 bg-white px-3 py-1 text-xs hover:bg-amber-100';
    reload.addEventListener('click', () => void load());
    node.appendChild(reload);
  }

  /** Saves the brand section; true when the draft now holds what is on screen. */
  async function saveBrand(): Promise<boolean> {
    const res = await rpc<Record<string, any>>('save_partner_brand_draft', {
      p: fields(),
      p_expected_updated_at: expectedUpdatedAt,
    });
    if (res.status === 'invalid') {
      showErrors(res.errors ?? []);
      return false;
    }
    if (res.status === 'stale') {
      staleBanner();
      return false;
    }
    if (res.status === 'in_review') {
      banner('info', 'Your changes are already with the team.');
      return false;
    }
    if (res.status === 'forbidden_brand') {
      banner('info', 'Brand details are changed by a brand login. Your login covers its venues under Locations.');
      return false;
    }
    if (res.status !== 'ok') {
      toast(`Could not save (${res.status}).`);
      return false;
    }
    expectedUpdatedAt = (res.updated_at as string | undefined) ?? expectedUpdatedAt;
    return true;
  }

  el<HTMLFormElement>('brand-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    show('form-errors', false);
    if (!(await saveBrand())) return;
    toast('Draft saved.');
    banner('info', "You have a draft in progress. Submit it when it's ready.");
  });

  el('btn-submit').addEventListener('click', async () => {
    show('form-errors', false);
    if (!(await saveBrand())) return;
    const res = await rpc<Record<string, any>>('submit_partner_brand_draft');
    if (res.status === 'ok') {
      banner('good', 'Submitted. The FitCreature team will review it shortly.');
      el<HTMLButtonElement>('btn-save').disabled = true;
      el<HTMLButtonElement>('btn-submit').disabled = true;
    } else if (res.status === 'agreements_required') {
      banner('warn', 'Please accept the current agreements on the Overview page first.');
    } else if (res.status === 'forbidden_submit') {
      banner('info', submitBlockText(res.reason));
    } else if (res.status === 'location_required') {
      banner('warn', 'A location in this draft still needs its map pin. Add it under Locations, then submit.');
    } else if (res.status === 'invalid') {
      showErrors(res.errors ?? []);
    } else {
      toast(`Could not submit (${res.status}).`);
    }
  });

  void requireSession().then(load).catch((err) => {
    if (!String(err).includes('redirecting')) {
      show('brand-loading', false);
      banner('warn', String(err));
    }
  });
</script>
