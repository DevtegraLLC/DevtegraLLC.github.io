---
// https://devtegra.com/fitcreature/patch-notes/
// One entry per FitCreature build released on both stores, newest first.
// Anchor per build: #<version>-<build>, e.g. #1.0.0-29.
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

const entries = (await getCollection('patchNotes')).sort((a, b) => b.data.build - a.data.build);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const slug = (e: (typeof entries)[number]) => `${e.data.version}-${e.data.build}`;
---

<Base
  title="FitCreature Patch Notes | Devtegra"
  description="What changed in each FitCreature release on the App Store and Google Play."
  ogImage="/brand/icons/fc_appicon_1024.png"
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-sm font-medium text-indigo-600">
      <a href="/fitcreature" class="hover:underline">FitCreature</a>
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900">Patch notes</h1>
    <p class="mt-4 leading-relaxed text-slate-600">
      What changed in each FitCreature release. An update appears here once it is
      available on both the App Store and Google Play.
    </p>

    {rendered.length === 0 ? (
      <div id="in-testing" class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-xl font-semibold text-slate-900">FitCreature is in testing</h2>
        <p class="mt-3 leading-relaxed text-slate-600">
          The first public release is on its way. Notes for every store release will
          be posted here from launch on.
        </p>
      </div>
    ) : (
      <div class="mt-12 space-y-12">
        {rendered.map(({ entry, Content }) => (
          <article id={slug(entry)} class="scroll-mt-8 border-t border-slate-200 pt-10">
            <p class="text-sm font-medium text-indigo-600">
              <a href={`#${slug(entry)}`} class="hover:underline">Version {entry.data.version} (build {entry.data.build})</a>
            </p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">{entry.data.title}</h2>
            <p class="mt-2 text-sm text-slate-500">
              App Store {fmt(entry.data.iosReleasedAt)} &middot; Google Play {fmt(entry.data.androidReleasedAt)}
            </p>
            <div class="prose prose-slate mt-6 max-w-none prose-headings:text-lg prose-headings:font-semibold prose-headings:tracking-tight">
              <Content />
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
