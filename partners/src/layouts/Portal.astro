---
// The portal shell: header + nav for signed-in pages. Pages that pass
// `nav={false}` (sign-in, print layouts) render bare.
interface Props {
  title: string;
  nav?: boolean;
}
const { title, nav = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · FitCreature Partners</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🤝</text></svg>" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    {
      nav && (
        <header class="border-b border-slate-200 bg-white">
          <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
            <a href="/dashboard" class="text-sm font-bold tracking-tight">
              FitCreature <span class="text-indigo-600">Partners</span>
            </a>
            <nav class="flex items-center gap-4 text-sm text-slate-600">
              <a href="/dashboard" class="hover:text-slate-900">Overview</a>
              <a href="/brand" class="hover:text-slate-900">Brand</a>
              <a href="/listing" class="hover:text-slate-900">Locations</a>
              <a href="/members" class="hover:text-slate-900">Members</a>
              <a href="/screen" class="hover:text-slate-900">Lobby screen</a>
              <a href="/report" class="hover:text-slate-900">Report</a>
              <a href="/print-pack" class="hover:text-slate-900">Print pack</a>
              {/* Team is brand-admin only (Decision 6.139). Hidden until the
                  role is known; the server refuses the page's calls anyway. */}
              <a id="nav-team" href="/team" class="hover:text-slate-900" hidden>
                Team
              </a>
              <a href="/account" class="hover:text-slate-900">Account</a>
              <button id="nav-signout" class="rounded-md border border-slate-300 px-3 py-1 hover:bg-slate-100">
                Sign out
              </button>
            </nav>
          </div>
        </header>
      )
    }
    <main class="mx-auto max-w-4xl px-6 py-10">
      <slot />
    </main>
    {
      nav && (
        <script>
          import { signOut, syncNavRole } from '../lib/portal';
          document.getElementById('nav-signout')?.addEventListener('click', () => void signOut());
          // The Team link follows the login's role. Painted from the
          // remembered role first, then confirmed with the server; a page that
          // loads the role itself calls cacheRole and paints sooner.
          void syncNavRole().catch(() => {
            // Not a partner session, or the call did not come back: Team stays
            // hidden, and every team RPC is refused server-side regardless.
          });
        </script>
      )
    }
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
