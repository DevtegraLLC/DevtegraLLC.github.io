---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, ogImage, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/about', label: 'About' },
  { href: '/fitcreature', label: 'FitCreature' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Devtegra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased flex flex-col">
    <header class="border-b border-slate-100">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href="/" class="text-xl font-semibold tracking-tight text-slate-900">
          Devtegra<span class="text-indigo-500">.</span>
        </a>
        <nav aria-label="Main">
          <ul class="flex items-center gap-6 text-sm font-medium text-slate-600">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-indigo-600">{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-100 bg-slate-50">
      <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-slate-500">
        <nav aria-label="Legal">
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            <li><a href="/privacy-policy" class="hover:text-indigo-600">Privacy Policy</a></li>
            <li><a href="/consumer-health-data-privacy" class="hover:text-indigo-600">Consumer Health Data Privacy Policy</a></li>
            <li><a href="/terms-of-service" class="hover:text-indigo-600">Terms of Service</a></li>
            <li><a href="/data-deletion" class="hover:text-indigo-600">Data Deletion</a></li>
            <li><a href="/security" class="hover:text-indigo-600">Security</a></li>
          </ul>
        </nav>
        <p class="mt-6">
          &copy; 2026 Devtegra, LLC &middot;
          <a href="mailto:contact.us@devtegra.com" class="hover:text-indigo-600">contact.us@devtegra.com</a>
        </p>
      </div>
    </footer>
  </body>
</html>
