---
import Portal from '../layouts/Portal.astro';
---

<Portal title="Your locations">
  <h1 class="text-2xl font-bold tracking-tight">Your locations</h1>
  <p class="mt-2 text-sm text-slate-600">
    Every venue on your card, edited together and sent to the FitCreature team as one submission.
    Each location has its own name, address, map pin, and location-only perks. Add as many venues as
    you run: a new venue gets its code, printable QR, and lobby-screen profile once the submission is
    approved. Your name, website, logo, and the perks every venue honors live under
    <a class="underline" href="/brand">Brand</a>.
  </p>

  <p id="listing-loading" class="mt-4 text-sm text-slate-500">Loading…</p>

  {/* Role line (Decision 6.139): a location manager edits the venues assigned
      to its login, and the server sends back only those. */}
  <p id="role-note" hidden class="mt-4 rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-700"></p>

  <div id="status-banner" hidden class="mt-4 rounded-lg border p-4 text-sm"></div>
  <p id="scope-hint" hidden class="mt-2 text-xs text-slate-500">
    Your card is shown to players near your venues, so every location needs its map pin (latitude and
    longitude) before it can go live.
  </p>

  <form id="listing-form" hidden class="mt-6 space-y-6">
    <div id="loc-cards" class="space-y-6"></div>

    <button type="button" id="loc-add"
      class="w-full rounded-lg border-2 border-dashed border-slate-300 px-4 py-3 text-sm font-medium text-slate-600 hover:border-indigo-400 hover:text-indigo-600">
      + Add location
    </button>

    <div id="form-errors" hidden class="rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"></div>

    <div class="flex gap-3">
      <button type="submit" id="btn-save"
        class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 disabled:opacity-50">
        Save draft
      </button>
      <button type="button" id="btn-submit"
        class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50">
        Submit for review
      </button>
    </div>
    {/* partner_draft_submit_block: why this login cannot send the submission
        as it stands, so nobody waits on a button that would be refused. */}
    <p id="submit-note" hidden class="text-sm text-slate-600"></p>
  </form>

  {/* Venue lifecycle (Decision 6.140). Closing is immediate and reversible for
      a grace window; the archive at the end of it is not. Both live outside the
      draft form: a closed venue is a business decision, not a submission, and
      it stays available while a draft is with the review team. */}
  <p id="lifecycle-note" hidden class="mt-8 rounded-lg border p-4 text-sm"></p>

  <section id="retired-section" hidden class="mt-10">
    <h2 class="text-sm font-semibold">Closed locations</h2>
    <p class="mt-1 text-xs text-slate-500">
      A closed location keeps everything it had for <span id="retired-grace">30</span> days, so reopening
      brings back its card, its members, and its printed codes. After that window its member list is
      cleared and the location is archived, which cannot be undone.
    </p>
    <div id="retired-list" class="mt-3 space-y-3"></div>
  </section>

  {/* Step one of the two-step close: everything preview_partner_location_retire
      reports, before anything happens. Step two is the confirm on the button. */}
  <div id="retire-overlay" hidden class="fixed inset-0 z-40 flex items-center justify-center bg-slate-900/40 p-4">
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="retire-title"
      class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-xl border border-slate-200 bg-white p-6 shadow-xl"
    >
      <h2 id="retire-title" class="text-base font-semibold">Close this location</h2>
      <p id="retire-sub" class="mt-1 text-xs text-slate-500"></p>

      <p class="mt-4 text-sm text-slate-700">Closing a location does three things:</p>
      <ul class="mt-2 list-disc space-y-2 pl-5 text-sm text-slate-700">
        <li>
          The lobby screen goes dark now. Its current link stops working, and reopening does not bring
          that link back, so a fresh one is created for the screen.
        </li>
        <li>
          Printed codes stop working now. Posters, tent cards, and any QR already in the wild send people
          to a page saying the location is closed, instead of to your welcome perk.
        </li>
        <li>
          After <span id="retire-grace">30</span> days the member list is cleared, and that part cannot be
          undone. Until then, reopening restores it.
        </li>
      </ul>

      <div id="retire-facts" class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700"></div>
      <div id="retire-warnings" hidden class="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"></div>

      <div class="mt-4">
        <label for="retire-reason" class="block text-sm font-medium">Reason (optional)</label>
        <input
          id="retire-reason"
          type="text"
          placeholder="Lease ended, moved to the North venue…"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
        <p class="mt-1 text-xs text-slate-500">
          <span id="retire-reason-count"></span> · kept with your records, and shown here while the location is closed.
        </p>
      </div>

      <p id="retire-error" hidden class="mt-3 text-sm text-rose-700"></p>

      <div class="mt-5 flex flex-wrap gap-3">
        <button
          type="button"
          id="retire-cancel"
          class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100"
        >
          Keep it open
        </button>
        <button
          type="button"
          id="retire-go"
          class="rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-500 disabled:opacity-50"
        >
          Close this location
        </button>
      </div>
    </div>
  </div>
</Portal>

<script>
  import {
    cacheRole,
    contactSourceText,
    el,
    fmtDate,
    fmtDateTime,
    MUTED_BADGE_TEXT,
    mutedEventText,
    type NotifySettings,
    rawSwitch,
    requireSession,
    retireStatusText,
    rpc,
    settingsErrorLines,
    settingsStatusText,
    show,
    STALE_DRAFT_TEXT,
    submitBlockText,
    switchIsLitButOff,
    toast,
  } from '../lib/portal';

  interface Perk {
    title: string | null;
    description: string | null;
    discount_code: string | null;
  }

  // One live venue as get_my_partner_brand().live.locations reports it. The
  // array is already filtered to what this login may touch (Decision 6.139),
  // so presence IS the capability; `via` only says how it is reached.
  interface LiveLocation {
    code_id: string;
    code: string;
    label: string | null;
    address: string | null;
    latitude: number | null;
    longitude: number | null;
    has_location: boolean;
    via: string;
    perks: Perk[];
  }

  // The wire shape of one draft entry (save_partner_locations_draft).
  // entry_id is minted by the server on first save and is the merge key: a
  // save replaces exactly the entries it carries and keeps everything else.
  interface LocationEntry {
    entry_id?: string;
    code_id?: string;
    label: string | null;
    address: string | null;
    latitude: string | number | null;
    longitude: string | number | null;
    perks: Perk[];
  }

  // One closed venue as get_my_partner_brand().retired_locations reports it
  // (Decision 6.140). Present until the sweep archives it at archive_due_at.
  interface RetiredLocation {
    code_id: string;
    code: string;
    label: string | null;
    address: string | null;
    retired_at: string | null;
    retire_reason: string | null;
    archive_due_at: string | null;
  }

  // preview_partner_location_retire: what closing WOULD do, read-only, with
  // the same authorization as the close itself.
  interface RetirePreview {
    status: string;
    label?: string | null;
    code?: string;
    grace_days?: number;
    archive_due_at?: string | null;
    member_count?: number;
    pending_count?: number;
    snapshot_rows?: number;
    venue_perks?: number;
    draft_entries?: number;
    draft_in_review?: boolean;
    logins_without_active_venue?: Array<{ contact_name: string | null; status: string }>;
    is_last_active_venue?: boolean;
  }

  let limits: Record<string, number> = {};
  let inReview = false;
  // can_retire_location (brand admin). Presentation only: the server refuses a
  // manager's call either way, and this only keeps a doomed button off screen.
  let canRetire = false;
  let graceDays = 30;
  // The venue the open confirm is about, so the close acts on what was previewed.
  let retireTarget: { code_id: string; name: string; dueAt: string | null } | null = null;
  let liveByCode = new Map<string, LiveLocation>();
  // Per-venue notification settings, keyed by code_id. They come from
  // get_my_partner_locations (Decisions 6.141 / 6.142), NOT from the draft:
  // notifications are live settings, so every control acts straight away and a
  // submission with the review team never holds one up.
  let settingsByCode = new Map<string, NotifySettings>();
  // The draft's concurrency token: null when the brand has no open draft.
  let expectedUpdatedAt: string | null = null;
  // Entries withdrawn from the draft since the last save (p_remove_entry_ids).
  let removedEntryIds: string[] = [];

  const esc = (v: unknown): string =>
    String(v ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

  const input = (root: ParentNode, key: string): HTMLInputElement =>
    root.querySelector(`[data-k="${key}"]`) as HTMLInputElement;

  function perkRow(perk: Perk = { title: '', description: '', discount_code: '' }): HTMLElement {
    const row = document.createElement('div');
    row.className = 'perk-row grid gap-2 rounded-lg border border-slate-200 bg-white p-3 sm:grid-cols-[1fr_1fr_8rem_auto]';
    row.innerHTML = `
      <input data-k="title" placeholder="Perk title" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
      <input data-k="description" placeholder="Where and how to use it (optional)" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
      <input data-k="discount_code" placeholder="CODE" class="rounded-md border border-slate-300 px-2 py-1.5 text-sm uppercase" />
      <button type="button" class="perk-remove text-sm text-slate-400 hover:text-rose-600">Remove</button>`;
    input(row, 'title').value = perk.title ?? '';
    input(row, 'description').value = perk.description ?? '';
    input(row, 'discount_code').value = perk.discount_code ?? '';
    row.querySelector('.perk-remove')!.addEventListener('click', () => row.remove());
    return row;
  }

  function readPerks(card: HTMLElement): Perk[] {
    return [...card.querySelectorAll('.perk-row')].map((row) => ({
      title: input(row, 'title').value || null,
      description: input(row, 'description').value || null,
      discount_code: input(row, 'discount_code').value || null,
    }));
  }

  // -------------------------------------------------------------------------
  // Per-venue notifications (Decisions 6.141 / 6.142). Live settings, never
  // part of the draft: a write lands straight away, which is why setEditing
  // deliberately leaves this subtree alone while a submission is in review.
  // -------------------------------------------------------------------------

  function paintMutedBadge(card: HTMLElement, s: NotifySettings | undefined): void {
    const badge = card.querySelector('[data-muted]') as HTMLElement | null;
    if (!badge) return;
    badge.textContent = MUTED_BADGE_TEXT;
    badge.hidden = !(s != null && s.notifications_enabled === false);
  }

  function notifyNoteFor(card: HTMLElement, kind: 'warn' | 'good', text: string): void {
    const node = card.querySelector('[data-notify-note]') as HTMLElement | null;
    if (!node) return;
    node.hidden = false;
    node.className = `mt-3 rounded-md border p-3 text-xs ${
      kind === 'warn' ? 'border-amber-300 bg-amber-50 text-amber-900' : 'border-emerald-300 bg-emerald-50 text-emerald-900'
    }`;
    node.textContent = text;
  }

  /**
   * One venue settings write. Key presence is the instruction, so the patch
   * carries ONLY what changed: an explicit null clears the address (falling
   * back to the brand's, then to the brand logins'), an absent key leaves that
   * field alone. Returns the fresh block, or null once the reason is shown.
   */
  async function writeVenueSettings(
    card: HTMLElement,
    codeId: string,
    patch: Record<string, unknown>,
  ): Promise<NotifySettings | null> {
    let res: Record<string, any>;
    try {
      res = await rpc<Record<string, any>>('set_partner_location_settings', { p_code_id: codeId, p: patch });
    } catch {
      notifyNoteFor(card, 'warn', 'That did not go through, so nothing changed. Reload the page and try again.');
      return null;
    }
    if (res.status === 'invalid') {
      notifyNoteFor(card, 'warn', settingsErrorLines(res.errors).join(' '));
      return null;
    }
    if (res.status !== 'ok') {
      notifyNoteFor(card, 'warn', settingsStatusText(res.status));
      return null;
    }
    const next = (res.settings ?? null) as NotifySettings | null;
    if (next) settingsByCode.set(codeId, next);
    return next;
  }

  function paintVenueNotifyBody(card: HTMLElement, live: LiveLocation): void {
    const body = card.querySelector('[data-notify-body]') as HTMLElement | null;
    if (!body) return;
    const s = settingsByCode.get(live.code_id);
    body.innerHTML = '';
    if (!s) {
      const missing = document.createElement('p');
      missing.className = 'mt-3 text-xs text-slate-500';
      missing.textContent =
        'Notification settings for this location could not be loaded just now. Reload the page to see them.';
      body.appendChild(missing);
      return;
    }

    const repaint = (): void => {
      paintVenueNotifyBody(card, live);
      paintMutedBadge(card, settingsByCode.get(live.code_id));
    };

    // --- The address -------------------------------------------------------
    const addressWrap = document.createElement('div');
    addressWrap.className = 'mt-3';
    const label = document.createElement('label');
    label.className = 'block text-sm font-medium';
    label.textContent = 'Notification address for this location';
    const field = document.createElement('input');
    field.type = 'email';
    field.autocomplete = 'off';
    field.placeholder = 'north@yourgym.example';
    field.className = 'mt-1 w-full max-w-sm rounded-md border border-slate-300 bg-white px-3 py-2 text-sm';
    field.value = s.contact_email ?? '';
    field.id = `notify-email-${live.code_id}`;
    label.htmlFor = field.id;
    addressWrap.appendChild(label);

    const row = document.createElement('div');
    row.className = 'mt-1 flex flex-wrap items-center gap-2';
    row.appendChild(field);
    const save = document.createElement('button');
    save.type = 'button';
    save.className = 'rounded-md bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-700 disabled:opacity-50';
    save.textContent = 'Save address';
    save.addEventListener('click', async () => {
      const value = field.value.trim();
      save.disabled = true;
      const next = await writeVenueSettings(card, live.code_id, { contact_email: value === '' ? null : value });
      save.disabled = false;
      if (!next) return;
      repaint();
      notifyNoteFor(
        card,
        'good',
        value === ''
          ? 'Address cleared. This location follows the address named below the field now.'
          : "Address saved. This location's notices go there from now on.",
      );
    });
    row.appendChild(save);
    if (s.contact_email != null) {
      const clear = document.createElement('button');
      clear.type = 'button';
      clear.className = 'rounded-md border border-slate-300 bg-white px-3 py-2 text-xs hover:bg-slate-100';
      clear.textContent = 'Clear it';
      clear.addEventListener('click', async () => {
        clear.disabled = true;
        const next = await writeVenueSettings(card, live.code_id, { contact_email: null });
        clear.disabled = false;
        if (!next) return;
        repaint();
        notifyNoteFor(card, 'good', 'Address cleared. This location follows the address named below the field now.');
      });
      row.appendChild(clear);
    }
    addressWrap.appendChild(row);

    // Never an empty box: the resolved answer and the tier it came from. An
    // INHERITED address is redacted for a location manager, so the sentence
    // says where notices go without naming the brand's own addresses.
    const source = document.createElement('p');
    source.className = 'mt-2 text-sm text-slate-700';
    source.textContent = contactSourceText(s, 'venue');
    addressWrap.appendChild(source);

    const hint = document.createElement('p');
    hint.className = 'mt-1 text-xs text-slate-500';
    hint.textContent =
      'Leaving this empty is fine. Notices then follow your brand address, and the sign-in address of your brand login when no brand address is set.';
    addressWrap.appendChild(hint);
    body.appendChild(addressWrap);

    // --- The master switch -------------------------------------------------
    const masterWrap = document.createElement('div');
    masterWrap.className = 'mt-5 border-t border-slate-100 pt-4';
    const masterLabel = document.createElement('label');
    masterLabel.className = 'flex items-center gap-3 text-sm font-medium';
    const master = document.createElement('input');
    master.type = 'checkbox';
    master.className = 'h-4 w-4';
    master.checked = s.notifications_enabled === true;
    master.id = `notify-master-${live.code_id}`;
    masterLabel.htmlFor = master.id;
    masterLabel.appendChild(master);
    const masterText = document.createElement('span');
    masterText.textContent = 'Send notices for this location';
    masterLabel.appendChild(masterText);
    masterWrap.appendChild(masterLabel);
    const masterHint = document.createElement('p');
    masterHint.className = 'mt-1 text-xs text-slate-500';
    masterHint.textContent =
      "Turning this off pauses this location's notices. Its address is kept, and your other locations are unaffected.";
    masterWrap.appendChild(masterHint);
    master.addEventListener('change', async () => {
      const wanted = master.checked;
      master.disabled = true;
      const next = await writeVenueSettings(card, live.code_id, { notifications_enabled: wanted });
      master.disabled = false;
      if (!next) {
        master.checked = !wanted;
        return;
      }
      repaint();
      notifyNoteFor(
        card,
        'good',
        wanted
          ? 'Notices for this location are on again.'
          : 'Notices for this location are paused. Its address is kept, and your other locations are unchanged.',
      );
    });
    body.appendChild(masterWrap);

    // --- The one per-event switch this level carries -----------------------
    const eventWrap = document.createElement('div');
    eventWrap.className = 'mt-5 border-t border-slate-100 pt-4';
    const eventLabel = document.createElement('label');
    eventLabel.className = 'flex items-start gap-3 text-sm font-medium';
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.className = 'mt-0.5 h-4 w-4';
    // The RAW switch, which is what a toggle renders. The master is shown
    // separately, so the switch never lies about what the partner chose.
    box.checked = rawSwitch(s, 'member_join_request');
    box.id = `notify-join-${live.code_id}`;
    eventLabel.htmlFor = box.id;
    eventLabel.appendChild(box);
    const eventText = document.createElement('span');
    eventText.textContent = 'Someone asks to join this location';
    eventLabel.appendChild(eventText);
    eventWrap.appendChild(eventLabel);
    const eventHint = document.createElement('p');
    eventHint.className = 'ml-7 mt-1 text-xs text-slate-500';
    eventHint.textContent = 'A player has scanned your code and is waiting on the Members page to be let in.';
    eventWrap.appendChild(eventHint);
    // Lit but not sending, because the master above is off. The switch stays
    // visibly on and says so, rather than appearing to do nothing.
    if (switchIsLitButOff(s, 'member_join_request')) {
      const muted = document.createElement('p');
      muted.className = 'ml-7 mt-1 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-900';
      muted.textContent = mutedEventText('venue');
      eventWrap.appendChild(muted);
    }
    box.addEventListener('change', async () => {
      const wanted = box.checked;
      box.disabled = true;
      const next = await writeVenueSettings(card, live.code_id, { notify_member_join_request: wanted });
      box.disabled = false;
      if (!next) {
        box.checked = !wanted;
        return;
      }
      repaint();
      notifyNoteFor(card, 'good', wanted ? 'On: join requests for this location.' : 'Off: join requests for this location.');
    });
    body.appendChild(eventWrap);

    const when = document.createElement('p');
    when.className = 'mt-4 text-xs text-slate-500';
    when.textContent = s.updated_at
      ? `Last changed ${fmtDateTime(s.updated_at)}.`
      : 'Not changed yet, so these are the starting settings.';
    body.appendChild(when);
  }

  function mountVenueNotify(card: HTMLElement, live: LiveLocation): void {
    const host = card.querySelector('[data-notify]') as HTMLElement | null;
    if (!host) return;
    host.innerHTML = '';
    const details = document.createElement('details');
    details.className = 'rounded-lg border border-slate-200 bg-white p-4';
    const summary = document.createElement('summary');
    summary.className = 'cursor-pointer text-sm font-semibold';
    summary.textContent = 'Notifications';
    details.appendChild(summary);
    const body = document.createElement('div');
    body.setAttribute('data-notify-body', '');
    details.appendChild(body);
    const note = document.createElement('p');
    note.setAttribute('data-notify-note', '');
    note.hidden = true;
    details.appendChild(note);
    host.appendChild(details);
    paintVenueNotifyBody(card, live);
    paintMutedBadge(card, settingsByCode.get(live.code_id));
  }

  // One card per venue: a live location (code_id set) or a new one (none yet).
  // A card carries the draft entry_id it stands for, so a save addresses the
  // same entry every time and a withdrawal names it explicitly.
  function locationCard(live: LiveLocation | null, seed: Partial<LocationEntry>): HTMLElement {
    const card = document.createElement('section');
    card.className = 'loc-card rounded-lg border border-slate-200 bg-slate-50 p-5 space-y-4';
    if (live) card.dataset.codeId = live.code_id;
    if (seed.entry_id) card.dataset.entryId = seed.entry_id;
    const meta: string[] = [];
    if (live) {
      meta.push(`<span class="font-mono">${esc(live.code)}</span>`);
      if (!live.has_location) meta.push('no map pin yet');
    } else {
      meta.push('new venue: its code is assigned at approval');
    }
    card.innerHTML = `
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-sm font-semibold" data-title></h2>
            <span data-muted hidden class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs text-amber-900"></span>
          </div>
          <p class="text-xs text-slate-500">${meta.join(' · ')}</p>
        </div>
        <div class="flex shrink-0 items-center gap-3">
          ${live ? '<button type="button" data-discard hidden class="text-sm text-slate-400 hover:text-rose-600">Discard staged change</button>' : ''}
          ${live && canRetire ? '<button type="button" data-retire class="text-sm text-slate-500 hover:text-rose-600">Close this location</button>' : ''}
          ${live ? '' : '<button type="button" data-remove class="text-sm text-slate-400 hover:text-rose-600">Remove</button>'}
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium">Location name</label>
        <input data-k="label" type="text" placeholder="Downtown, North, Round Rock…" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" />
        <p class="mt-1 text-xs text-slate-500"><span data-count="label"></span> · how this venue is told apart from your others in the app · leave empty for a single location</p>
      </div>
      <div>
        <label class="block text-sm font-medium">Address</label>
        <input data-k="address" type="text" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" />
        <p class="mt-1 text-xs text-slate-500"><span data-count="address"></span> · one line, around 10-15 words</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium">Latitude</label>
          <input data-k="latitude" type="text" inputmode="decimal" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium">Longitude</label>
          <input data-k="longitude" type="text" inputmode="decimal" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" />
        </div>
        <p class="col-span-2 -mt-2 text-xs text-slate-500">
          This venue's map pin (both together${live ? ', or leave both empty to keep the current one' : ''}).
          The app decides which players see your card from the pin, so each location needs one.
        </p>
      </div>
      <div>
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold">Perks at this location only</h3>
          <button type="button" data-perk-add class="rounded-md border border-slate-300 bg-white px-3 py-1 text-xs hover:bg-slate-100">
            Add perk
          </button>
        </div>
        <p class="mt-1 text-xs text-slate-500">
          Up to ${esc(limits.max_perks ?? 5)} offers honored at this venue. Discount codes: letters and numbers only.
          Offers every venue honors go under <a class="underline" href="/brand">Brand</a>.
        </p>
        <div data-perk-rows class="mt-3 space-y-3"></div>
      </div>
      <div data-notify></div>`;

    input(card, 'label').value = String(seed.label ?? '');
    input(card, 'address').value = String(seed.address ?? '');
    input(card, 'latitude').value = seed.latitude != null ? String(seed.latitude) : '';
    input(card, 'longitude').value = seed.longitude != null ? String(seed.longitude) : '';
    const rows = card.querySelector('[data-perk-rows]') as HTMLElement;
    for (const perk of seed.perks ?? []) rows.appendChild(perkRow(perk));

    const title = card.querySelector('[data-title]') as HTMLElement;
    const retitle = () => {
      const label = input(card, 'label').value.trim();
      const address = input(card, 'address').value.trim();
      title.textContent = label || address || (live ? 'Unnamed location' : 'New location');
    };
    // The venue name's limit is named location_label in partner_field_limits.
    const LIMIT_KEY: Record<string, string> = { label: 'location_label', address: 'address' };
    for (const key of ['label', 'address'] as const) {
      const field = input(card, key);
      const count = card.querySelector(`[data-count="${key}"]`) as HTMLElement;
      const update = () => {
        count.textContent = `${field.value.length}/${limits[LIMIT_KEY[key]] ?? '…'} characters`;
        retitle();
      };
      field.oninput = update;
      update();
    }

    card.querySelector('[data-perk-add]')!.addEventListener('click', () => {
      if (card.querySelectorAll('.perk-row').length >= (limits.max_perks ?? 5)) {
        toast(`Up to ${limits.max_perks ?? 5} perks per location.`);
        return;
      }
      rows.appendChild(perkRow());
    });

    // A new venue that is only staged: withdrawing it names its entry so the
    // next save removes exactly that entry and leaves the rest in place.
    card.querySelector('[data-remove]')?.addEventListener('click', () => {
      if (card.dataset.entryId) removedEntryIds.push(card.dataset.entryId);
      card.remove();
    });

    // Closing the venue (Decision 6.140). Never a draft action: it acts on the
    // live venue straight away, so it sits outside the save flow entirely.
    if (live) {
      card.querySelector('[data-retire]')?.addEventListener('click', () => void openRetire(live));
      mountVenueNotify(card, live);
    } else {
      // A proposed venue has no code yet, so it has no settings row to edit.
      const host = card.querySelector('[data-notify]') as HTMLElement | null;
      if (host) {
        const soon = document.createElement('p');
        soon.className = 'text-xs text-slate-500';
        soon.textContent =
          'This venue gets its own notification address and switches once the submission is approved and its code is assigned. Until then its notices follow your brand address.';
        host.appendChild(soon);
      }
    }

    // A live venue with a staged change can go back to what is live today.
    const discard = card.querySelector('[data-discard]') as HTMLButtonElement | null;
    if (discard && live) {
      discard.hidden = !seed.entry_id;
      discard.addEventListener('click', () => {
        if (card.dataset.entryId) removedEntryIds.push(card.dataset.entryId);
        delete card.dataset.entryId;
        discard.hidden = true;
        input(card, 'label').value = live.label ?? '';
        input(card, 'address').value = live.address ?? '';
        input(card, 'latitude').value = live.latitude != null ? String(live.latitude) : '';
        input(card, 'longitude').value = live.longitude != null ? String(live.longitude) : '';
        rows.innerHTML = '';
        for (const perk of live.perks ?? []) rows.appendChild(perkRow(perk));
        for (const key of ['label', 'address'] as const) input(card, key).dispatchEvent(new Event('input'));
        toast('Staged change withdrawn. Save the draft to make it stick.');
      });
    }
    return card;
  }

  function cards(): HTMLElement[] {
    return [...el('loc-cards').querySelectorAll<HTMLElement>('.loc-card')];
  }

  function readCard(card: HTMLElement): LocationEntry {
    const entry: LocationEntry = {
      label: input(card, 'label').value || null,
      address: input(card, 'address').value || null,
      latitude: input(card, 'latitude').value || null,
      longitude: input(card, 'longitude').value || null,
      perks: readPerks(card),
    };
    if (card.dataset.codeId) entry.code_id = card.dataset.codeId;
    if (card.dataset.entryId) entry.entry_id = card.dataset.entryId;
    return entry;
  }

  // Normalized so a live venue and its untouched card compare equal: empty
  // strings are null, codes are uppercased, the pin is numeric.
  const text = (v: unknown): string | null => {
    const s = v == null ? '' : String(v).trim();
    return s === '' ? null : s;
  };
  const coord = (v: unknown): string | null => {
    const s = text(v);
    if (s == null) return null;
    const n = Number(s);
    return Number.isFinite(n) ? String(n) : s;
  };
  const perkKey = (perks: Perk[]): string =>
    JSON.stringify(perks.map((p) => [text(p.title), text(p.description), text(p.discount_code)?.toUpperCase() ?? null]));
  const entryKey = (e: { label: unknown; address: unknown; latitude: unknown; longitude: unknown; perks: Perk[] }): string =>
    JSON.stringify([text(e.label), text(e.address), coord(e.latitude), coord(e.longitude), perkKey(e.perks ?? [])]);

  // Only new venues and live venues whose card differs from the live row are
  // sent; the sent order is the card order so error indices map back.
  function collect(): { entries: LocationEntry[]; sent: HTMLElement[] } {
    const entries: LocationEntry[] = [];
    const sent: HTMLElement[] = [];
    for (const card of cards()) {
      const entry = readCard(card);
      const live = entry.code_id ? liveByCode.get(entry.code_id) : undefined;
      if (live && entryKey(live) === entryKey(entry)) continue;
      entries.push(entry);
      sent.push(card);
    }
    return { entries, sent };
  }

  function banner(kind: 'info' | 'warn' | 'good', text: string): void {
    const node = el('status-banner');
    node.hidden = false;
    node.className = `mt-4 rounded-lg border p-4 text-sm ${
      kind === 'warn'
        ? 'border-amber-300 bg-amber-50 text-amber-900'
        : kind === 'good'
          ? 'border-emerald-300 bg-emerald-50 text-emerald-900'
          : 'border-slate-200 bg-white text-slate-700'
    }`;
    node.textContent = text;
  }

  const CODE_TEXT: Record<string, string> = {
    required: 'is required',
    max_length: 'is too long',
    emoji: 'cannot contain emoji',
    url_in_name: 'cannot contain a link',
    html: 'cannot contain < or >',
    zero_width: 'contains hidden characters',
    control_or_astral: 'contains unsupported characters',
    format: 'must be letters and numbers only',
    not_an_array: 'could not be read',
    max_perks: `can hold up to ${limits.max_perks ?? 5} perks`,
  };
  const FIELD_TEXT: Record<string, string> = {
    label: 'location name',
    address: 'address',
    title: 'title',
    description: 'description',
    discount_code: 'discount code',
    perks: 'perks',
  };
  const PIN_TEXT: Record<string, string> = {
    pair_required: 'enter both latitude and longitude, or leave both empty',
    out_of_range: 'latitude and longitude are out of range',
    not_a_number: 'latitude and longitude must be numbers',
    required: 'needs its map pin (latitude + longitude) before it can go live',
  };

  // Every server field becomes a readable line; the location index (1-based
  // in the SENT array) is returned so the card can be highlighted.
  function describe(field: string, code: string): { text: string; index: number | null } {
    const readable = CODE_TEXT[code] ?? code.replaceAll('_', ' ');
    if (/^remove_\d+$/.test(field)) {
      return {
        text: 'One of the changes being withdrawn belongs to another login, so it stays in the submission.',
        index: null,
      };
    }
    const m = /^location_(\d+)(?:_(.+))?$/.exec(field);
    if (!m) {
      if (field === 'locations') {
        return {
          text: code === 'max_locations'
            ? `Up to ${limits.max_draft_locations ?? 50} locations per submission.`
            : `Locations ${readable}.`,
          index: null,
        };
      }
      if (field === 'draft' && code === 'empty') {
        return { text: 'Nothing to submit yet: change a location or add a venue first.', index: null };
      }
      if (field === 'business_name') {
        return { text: `Your brand's business name ${readable} (under Brand).`, index: null };
      }
      return { text: `${field.replaceAll('_', ' ')}: ${readable}`, index: null };
    }
    const index = Number(m[1]);
    const rest = m[2];
    if (!rest) {
      const whole: Record<string, string> = {
        unknown_location: 'that venue is no longer part of your brand',
        duplicate_location: 'the same venue appears twice',
        not_an_object: 'could not be read',
        forbidden_location: 'that venue is not one of the ones assigned to your login',
        forbidden_new_location: 'adding a venue is done by a brand login',
      };
      return { text: `Location ${index}: ${whole[code] ?? readable}.`, index };
    }
    if (rest === 'location') {
      const pin = PIN_TEXT[code] ?? readable;
      return { text: code === 'required' ? `Location ${index} ${pin}.` : `Location ${index}: ${pin}.`, index };
    }
    const perk = /^perk_(\d+)_(.+)$/.exec(rest);
    if (perk) {
      return { text: `Location ${index}, perk ${perk[1]}: ${FIELD_TEXT[perk[2]] ?? perk[2]} ${readable}.`, index };
    }
    return { text: `Location ${index}: ${FIELD_TEXT[rest] ?? rest.replaceAll('_', ' ')} ${readable}.`, index };
  }

  function clearHighlights(): void {
    for (const card of cards()) card.classList.remove('ring-2', 'ring-rose-400');
  }

  function showErrors(errors: Array<{ field: string; code: string }>, sent: HTMLElement[]): void {
    clearHighlights();
    const node = el('form-errors');
    node.hidden = false;
    node.innerHTML = '';
    const head = document.createElement('p');
    head.className = 'font-semibold';
    head.textContent = 'A few things to adjust:';
    node.appendChild(head);
    const list = document.createElement('ul');
    list.className = 'mt-2 list-disc pl-5';
    for (const e of errors) {
      const { text, index } = describe(String(e.field ?? ''), String(e.code ?? ''));
      const li = document.createElement('li');
      li.textContent = text;
      list.appendChild(li);
      const card = index != null ? sent[index - 1] : undefined;
      if (card) card.classList.add('ring-2', 'ring-rose-400');
    }
    node.appendChild(list);
    const first = sent.find((c) => c.classList.contains('ring-rose-400'));
    first?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function setEditing(enabled: boolean): void {
    el<HTMLButtonElement>('btn-save').disabled = !enabled;
    el<HTMLButtonElement>('btn-submit').disabled = !enabled;
    el<HTMLButtonElement>('loc-add').disabled = !enabled;
    for (const field of el('listing-form').querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button')) {
      if (field.id === 'btn-save' || field.id === 'btn-submit' || field.id === 'loc-add') continue;
      // Closing a location is not part of the submission, so a draft sitting
      // with the review team never holds it up (Decision 6.140).
      if (field.hasAttribute('data-retire')) continue;
      // Notification settings are live, not staged (Decisions 6.141 / 6.142),
      // so a submission in review leaves them editable for the same reason.
      if (field.closest('[data-notify]')) continue;
      field.disabled = !enabled;
    }
  }

  // -------------------------------------------------------------------------
  // Venue lifecycle (Decision 6.140): close, and reopen during the grace
  // window. Brand admin only, which the SERVER decides: can_retire_location
  // only keeps a button that would be refused off the screen.
  // -------------------------------------------------------------------------

  const venueName = (l: { label: string | null; address: string | null; code: string }): string =>
    l.label ?? l.address ?? l.code;

  function lifecycleNote(kind: 'info' | 'warn' | 'good', text: string): HTMLElement {
    const node = el('lifecycle-note');
    node.hidden = false;
    node.className = `mt-8 rounded-lg border p-4 text-sm ${
      kind === 'warn'
        ? 'border-amber-300 bg-amber-50 text-amber-900'
        : kind === 'good'
          ? 'border-emerald-300 bg-emerald-50 text-emerald-900'
          : 'border-slate-200 bg-white text-slate-700'
    }`;
    node.textContent = `${text} `;
    node.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    return node;
  }

  const RAISED_TEXT =
    'That did not go through, so nothing changed. Reload the page and try again. If this login has been suspended, the FitCreature team can help.';

  /**
   * One lifecycle write. Either a payload or a reason to show, never both, and
   * the CALLER decides where the reason lands: a refusal while the confirm
   * panel is open belongs in the panel, not on the page behind it. retire and
   * reopen answer a manager, an unknown venue and a wrong state with SOFT
   * statuses, but RAISE for a signed-out, non-partner or SUSPENDED login, so a
   * thrown error is an outcome here rather than only a transport failure.
   * Nothing is changed in either case.
   */
  async function lifecycleCall(
    fn: string,
    args: Record<string, unknown>,
  ): Promise<{ res: Record<string, any> | null; message: string | null }> {
    let res: Record<string, any>;
    try {
      res = await rpc<Record<string, any>>(fn, args);
    } catch {
      return { res: null, message: RAISED_TEXT };
    }
    if (res.status === 'ok') return { res, message: null };
    return { res: null, message: retireStatusText(res.status) };
  }

  function closeRetireOverlay(): void {
    retireTarget = null;
    show('retire-overlay', false);
  }

  function line(parent: HTMLElement, text: string): void {
    const p = document.createElement('p');
    p.className = parent.childElementCount === 0 ? '' : 'mt-2';
    p.textContent = text;
    parent.appendChild(p);
  }

  // Step one of two: everything the close would do, read from the server
  // before anything happens.
  async function openRetire(live: LiveLocation): Promise<void> {
    let preview: RetirePreview;
    try {
      preview = await rpc<RetirePreview>('preview_partner_location_retire', { p_code_id: live.code_id });
    } catch {
      lifecycleNote(
        'warn',
        'Could not check what closing this location would do, so nothing changed. Reload the page and try again.',
      );
      return;
    }
    if (preview.status !== 'ok') {
      lifecycleNote('warn', retireStatusText(preview.status));
      return;
    }

    const name = venueName(live);
    retireTarget = { code_id: live.code_id, name, dueAt: preview.archive_due_at ?? null };
    el('retire-title').textContent = `Close ${name}?`;
    el('retire-sub').textContent = `${live.code}${live.address ? ` · ${live.address}` : ''}`;
    el('retire-grace').textContent = String(preview.grace_days ?? graceDays);

    const facts = el('retire-facts');
    facts.innerHTML = '';
    const members = Number(preview.member_count ?? 0);
    const pending = Number(preview.pending_count ?? 0);
    line(
      facts,
      members === 0
        ? 'No members are on this location today.'
        : members === 1
          ? '1 member is on this location today, and their friendship is kept for the whole window.'
          : `${members} members are on this location today, and their friendships are kept for the whole window.`,
    );
    if (pending > 0) {
      line(facts, pending === 1 ? '1 join request is waiting and stops here.' : `${pending} join requests are waiting and stop here.`);
    }
    const perks = Number(preview.venue_perks ?? 0);
    if (perks > 0) {
      line(facts, perks === 1 ? '1 perk at this location stops showing on your card.' : `${perks} perks at this location stop showing on your card.`);
    }
    if (Number(preview.draft_entries ?? 0) > 0) {
      line(facts, 'A staged change for this location is in your current draft, and it comes out of the draft. Everything else you have staged stays.');
    }
    if (preview.draft_in_review === true) {
      line(facts, 'A submission that includes this location is with the FitCreature team right now, so they will come back to you about it.');
    }
    line(
      facts,
      preview.archive_due_at
        ? `Reopening is available until ${fmtDate(preview.archive_due_at)}. On that date the member list is cleared.`
        : 'Reopening is available until the grace window ends, when the member list is cleared.',
    );

    // The two consequences a partner is least likely to have thought about.
    const warnings = el('retire-warnings');
    warnings.innerHTML = '';
    if (preview.is_last_active_venue === true) {
      line(warnings, 'This is your only open location, so with it closed players no longer see a venue on your card.');
    }
    const stranded = preview.logins_without_active_venue ?? [];
    if (stranded.length > 0) {
      const who = stranded.map((s) => s.contact_name ?? 'an unnamed login').join(', ');
      line(
        warnings,
        stranded.length === 1
          ? `${who} would be left with no open location. That login can still sign in, and its pages fill up again once a location reopens or another is assigned.`
          : `These logins would be left with no open location: ${who}. They can still sign in, and their pages fill up again once a location reopens or another is assigned.`,
      );
    }
    warnings.hidden = warnings.childElementCount === 0;

    const reason = el<HTMLInputElement>('retire-reason');
    reason.value = '';
    reason.maxLength = limits.retire_reason ?? 200;
    const count = el('retire-reason-count');
    const paintCount = () => {
      count.textContent = `${reason.value.length}/${limits.retire_reason ?? 200} characters`;
    };
    reason.oninput = paintCount;
    paintCount();

    show('retire-error', false);
    show('retire-overlay', true);
    reason.focus();
  }

  function renderRetired(list: RetiredLocation[]): void {
    const wrap = el('retired-list');
    wrap.innerHTML = '';
    for (const loc of list) {
      const card = document.createElement('article');
      card.className = 'flex flex-wrap items-start justify-between gap-3 rounded-lg border border-slate-200 bg-white p-4';

      const who = document.createElement('div');
      const name = document.createElement('p');
      name.className = 'text-sm font-semibold';
      name.textContent = venueName(loc);
      who.appendChild(name);

      const meta = document.createElement('p');
      meta.className = 'text-xs text-slate-500';
      meta.textContent =
        `${loc.code}${loc.address ? ` · ${loc.address}` : ''}` +
        (loc.retired_at ? ` · closed ${fmtDate(loc.retired_at)}` : '');
      who.appendChild(meta);

      if (loc.retire_reason) {
        const reason = document.createElement('p');
        reason.className = 'mt-1 text-xs text-slate-500';
        reason.textContent = `Reason: ${loc.retire_reason}`;
        who.appendChild(reason);
      }

      const due = document.createElement('p');
      due.className = 'mt-2 text-xs text-amber-800';
      due.textContent = loc.archive_due_at
        ? `Archived on ${fmtDate(loc.archive_due_at)}, when the member list is cleared. Reopening is available until then.`
        : 'Reopening is available until the grace window ends.';
      who.appendChild(due);

      // A closed venue keeps its address (Decision 6.142); only the routing is
      // paused. Shown read-only, because every per-venue RPC answers a closed
      // venue with `retired` and a control here would be refused.
      const settings = settingsByCode.get(loc.code_id);
      if (settings) {
        const paused = document.createElement('p');
        paused.className = 'mt-2 text-xs text-slate-500';
        paused.textContent = `Notices are paused while this location is closed, and its address is kept. ${contactSourceText(settings, 'venue')} Reopening starts them again with nothing else to do.`;
        who.appendChild(paused);
      }
      card.appendChild(who);

      if (canRetire) {
        const reopen = document.createElement('button');
        reopen.type = 'button';
        reopen.className = 'shrink-0 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium hover:bg-slate-100';
        reopen.textContent = 'Reopen';
        reopen.addEventListener('click', async () => {
          reopen.disabled = true;
          const { res, message } = await lifecycleCall('reopen_partner_location', { p_code_id: loc.code_id });
          if (!res) {
            reopen.disabled = false;
            lifecycleNote('warn', message ?? RAISED_TEXT);
            return;
          }
          await load();
          // reopen_partner_location deliberately leaves the screen token NULL:
          // a link printed on a card in a closed lobby must not resume working.
          const note = lifecycleNote(
            'good',
            `${venueName(loc)} is open again, with its card, its members, and its printed codes back. Its lobby-screen link was not restored, so a fresh one is waiting to be created before the screen goes back on a TV.`,
          );
          const link = document.createElement('a');
          link.href = '/screen';
          link.className = 'font-medium underline';
          link.textContent = 'Open Lobby screen';
          note.appendChild(link);
        });
        card.appendChild(reopen);
      } else {
        const byBrand = document.createElement('p');
        byBrand.className = 'shrink-0 text-xs text-slate-500';
        byBrand.textContent = 'A brand login reopens a location.';
        card.appendChild(byBrand);
      }

      wrap.appendChild(card);
    }
    show('retired-section', list.length > 0);
  }

  async function load(): Promise<void> {
    show('status-banner', false);
    show('form-errors', false);
    show('listing-form', false);
    show('listing-loading', true);
    // The draft view and the live per-venue settings are two different reads:
    // get_my_partner_brand carries the submission, get_my_partner_locations
    // carries each venue's notification block (Decisions 6.141 / 6.142). The
    // settings read is allowed to fail on its own without taking the page down.
    const [brand, venues] = await Promise.all([
      rpc<Record<string, any>>('get_my_partner_brand'),
      rpc<Record<string, any>>('get_my_partner_locations').catch(() => ({ status: 'unavailable' }) as Record<string, any>),
    ]);
    show('listing-loading', false);
    if (brand.status !== 'ok') {
      banner('warn', `Could not load your locations (${brand.status}).`);
      return;
    }

    settingsByCode = new Map();
    if (venues.status === 'ok') {
      for (const v of (venues.locations ?? []) as Array<Record<string, any>>) {
        const settings = (v.settings ?? null) as NotifySettings | null;
        if (typeof v.code_id === 'string' && settings) settingsByCode.set(v.code_id, settings);
      }
    }
    limits = brand.field_limits ?? {};
    CODE_TEXT.max_perks = `can hold up to ${limits.max_perks ?? 5} perks`;
    cacheRole(brand.role);

    // Lifecycle flags, read before the cards are built so a card knows whether
    // it carries a close control (Decision 6.140).
    canRetire = brand.can_retire_location === true;
    graceDays = Number(brand.retire_grace_days ?? 30);
    el('retire-grace').textContent = String(graceDays);
    el('retired-grace').textContent = String(graceDays);
    renderRetired((brand.retired_locations ?? []) as RetiredLocation[]);

    const live = (brand.live ?? {}) as Record<string, any>;
    const draft = (brand.draft ?? null) as Record<string, any> | null;
    inReview = draft?.status === 'submitted';
    // The token every save must carry; null while the brand has no draft.
    expectedUpdatedAt = (draft?.updated_at as string | undefined) ?? null;
    removedEntryIds = [];
    const liveLocations = (live.locations ?? []) as LiveLocation[];
    liveByCode = new Map(liveLocations.map((l) => [l.code_id, l]));
    const draftEntries = ((draft?.locations ?? []) as Array<Record<string, any>>);
    const draftByCode = new Map<string, Record<string, any>>();
    const newEntries: Array<Record<string, any>> = [];
    for (const entry of draftEntries) {
      if (typeof entry.code_id === 'string' && liveByCode.has(entry.code_id)) draftByCode.set(entry.code_id, entry);
      else if (entry.code_id == null) newEntries.push(entry);
    }

    const wrap = el('loc-cards');
    wrap.innerHTML = '';
    for (const l of liveLocations) {
      const d = draftByCode.get(l.code_id);
      // A draft entry replaces label / address / perks wholesale; a missing
      // pin in the draft means "keep the live one", so the live pin shows.
      const seed: Partial<LocationEntry> = d
        ? {
            entry_id: d.entry_id as string | undefined,
            label: (d.label as string | undefined) ?? null,
            address: (d.address as string | undefined) ?? null,
            latitude: d.latitude ?? l.latitude,
            longitude: d.longitude ?? l.longitude,
            perks: (d.perks ?? []) as Perk[],
          }
        : { label: l.label, address: l.address, latitude: l.latitude, longitude: l.longitude, perks: l.perks ?? [] };
      wrap.appendChild(locationCard(l, seed));
    }
    for (const d of newEntries) {
      wrap.appendChild(
        locationCard(null, {
          entry_id: d.entry_id as string | undefined,
          label: (d.label as string | undefined) ?? null,
          address: (d.address as string | undefined) ?? null,
          latitude: d.latitude ?? null,
          longitude: d.longitude ?? null,
          perks: (d.perks ?? []) as Perk[],
        }),
      );
    }

    show('scope-hint', live.scope === 'regional');

    // Role presentation (Decision 6.139). The server already filtered these
    // arrays and refuses anything outside them, so this is wording, not a rule.
    const reach = liveLocations.length;
    const brandCount = Number(live.location_count ?? reach);
    const roleNote = el('role-note');
    if (brand.role === 'location_manager') {
      const others = brandCount - reach;
      roleNote.textContent =
        `Your login covers ${reach} of the ${brandCount} location${brandCount === 1 ? '' : 's'} on this card` +
        (others > 0
          ? others === 1
            ? '. The other venue is edited by the login that holds it.'
            : `. The other ${others} venues are edited by the logins that hold them.`
          : '.');
      roleNote.hidden = false;
    } else {
      roleNote.hidden = true;
    }
    // Adding a venue is a brand-admin action, so the control follows the flag.
    show('loc-add', brand.can_add_location !== false);

    const otherEntries = Number(draft?.other_entry_count ?? 0);
    const pending = draftEntries.length;
    if (inReview) {
      banner('info', 'Your changes are with the FitCreature team. Editing reopens once the review finishes.');
    } else if (draft?.status === 'changes_requested') {
      banner('warn', `Changes requested: ${draft.review_note ?? 'see the note from the team.'} Edit below and resubmit.`);
    } else if (draft) {
      const others =
        otherEntries > 0
          ? ` ${otherEntries} more change${otherEntries === 1 ? '' : 's'} from another login ride along and stay as they are.`
          : '';
      banner(
        'info',
        (pending > 0
          ? `You have a draft in progress with ${pending} location change${pending === 1 ? '' : 's'}. Submit it when it's ready.`
          : "You have a draft in progress. Submit it when it's ready.") + others,
      );
    }

    // can_submit / submit_block come from the server so the button and the
    // refusal can never disagree.
    const block = (brand.submit_block ?? null) as string | null;
    const submitNote = el('submit-note');
    const blocked = block !== null && block !== 'no_draft';
    if (blocked) {
      submitNote.textContent = submitBlockText(block);
      submitNote.hidden = false;
    } else {
      submitNote.hidden = true;
    }

    show('listing-form', true);
    setEditing(!inReview);
    if (!inReview && blocked) el<HTMLButtonElement>('btn-submit').disabled = true;
  }

  el('retire-cancel').addEventListener('click', closeRetireOverlay);
  el('retire-overlay').addEventListener('click', (e) => {
    if (e.target === el('retire-overlay')) closeRetireOverlay();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !el('retire-overlay').hidden) closeRetireOverlay();
  });

  // Step two of two. The panel above has already named every consequence; this
  // is the last chance to step back before the screen and the printed codes go.
  el('retire-go').addEventListener('click', async () => {
    if (!retireTarget) return;
    const target = retireTarget;
    const until = target.dueAt ? ` Reopening stays available until ${fmtDate(target.dueAt)}.` : '';
    if (
      !confirm(
        `Close ${target.name}? The lobby screen and every printed code stop working right away.${until}`,
      )
    ) {
      return;
    }
    const go = el<HTMLButtonElement>('retire-go');
    go.disabled = true;
    show('retire-error', false);
    const reason = el<HTMLInputElement>('retire-reason').value.trim();
    let outcome: { res: Record<string, any> | null; message: string | null };
    try {
      outcome = await lifecycleCall('retire_partner_location', {
        p_code_id: target.code_id,
        p_reason: reason === '' ? null : reason,
      });
    } finally {
      go.disabled = false;
    }
    const res = outcome.res;
    if (!res) {
      // The panel is still up, so the reason belongs inside it.
      const error = el('retire-error');
      error.textContent = outcome.message ?? RAISED_TEXT;
      error.hidden = false;
      return;
    }
    closeRetireOverlay();
    await load();
    lifecycleNote(
      'good',
      `${target.name} is closed. Its lobby screen and its printed codes stopped working just now.` +
        (res.archive_due_at
          ? ` It stays here, ready to reopen, until ${fmtDate(res.archive_due_at)}.`
          : ' It stays here, ready to reopen, until the grace window ends.'),
    );
  });

  el('loc-add').addEventListener('click', () => {
    const max = limits.max_draft_locations ?? 50;
    if (collect().entries.length >= max) {
      toast(`Up to ${max} location changes per submission.`);
      return;
    }
    const card = locationCard(null, { perks: [] });
    el('loc-cards').appendChild(card);
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    input(card, 'label').focus();
  });

  // One draft per brand, so another login may have saved since this page
  // loaded. A stale answer carries no draft body on purpose: reloading is the
  // only honest way forward, and it never overwrites their work.
  function staleBanner(): void {
    const node = el('status-banner');
    node.hidden = false;
    node.className = 'mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900';
    node.textContent = `${STALE_DRAFT_TEXT} `;
    const reload = document.createElement('button');
    reload.type = 'button';
    reload.textContent = 'Reload the submission';
    reload.className = 'rounded-md border border-amber-400 bg-white px-3 py-1 text-xs hover:bg-amber-100';
    reload.addEventListener('click', () => void load());
    node.appendChild(reload);
  }

  // Saves the draft; returns the sent cards on success, null when the caller
  // should stop (errors already shown).
  async function save(): Promise<HTMLElement[] | null> {
    show('form-errors', false);
    clearHighlights();
    const { entries, sent } = collect();
    const res = await rpc<Record<string, any>>('save_partner_locations_draft', {
      p_locations: entries,
      p_expected_updated_at: expectedUpdatedAt,
      p_remove_entry_ids: removedEntryIds,
    });
    if (res.status === 'invalid') {
      showErrors(res.errors ?? [], sent);
      return null;
    }
    if (res.status === 'stale') {
      staleBanner();
      return null;
    }
    if (res.status === 'in_review') {
      banner('info', 'Your changes are already with the team.');
      return null;
    }
    if (res.status !== 'ok') {
      toast(`Could not save (${res.status}).`);
      return null;
    }
    expectedUpdatedAt = (res.updated_at as string | undefined) ?? expectedUpdatedAt;
    removedEntryIds = [];
    return sent;
  }

  el<HTMLFormElement>('listing-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const sent = await save();
    if (!sent) return;
    toast('Draft saved.');
    // Reload so every card carries the entry_id the server minted, and so the
    // submit state reflects what is now in the submission.
    await load();
  });

  el('btn-submit').addEventListener('click', async () => {
    const sent = await save();
    if (!sent) return;
    const res = await rpc<Record<string, any>>('submit_partner_brand_draft');
    if (res.status === 'ok') {
      banner('good', 'Submitted. The FitCreature team will review it shortly.');
      setEditing(false);
    } else if (res.status === 'agreements_required') {
      banner('warn', 'Please accept the current agreements on the Overview page first.');
    } else if (res.status === 'forbidden_submit') {
      banner('info', submitBlockText(res.reason));
    } else if (res.status === 'location_required' || res.status === 'invalid') {
      showErrors(res.errors ?? [], sent);
    } else if (res.status === 'in_review') {
      banner('info', 'Your changes are already with the team.');
    } else if (res.status === 'no_draft') {
      banner('warn', 'Nothing to submit yet: change a location or add a venue first.');
    } else {
      toast(`Could not submit (${res.status}).`);
    }
  });

  void requireSession().then(load).catch((err) => {
    if (!String(err).includes('redirecting')) {
      show('listing-loading', false);
      banner('warn', String(err));
    }
  });
</script>
