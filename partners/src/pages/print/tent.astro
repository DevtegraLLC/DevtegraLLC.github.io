---
import Portal from '../../layouts/Portal.astro';
---

<Portal title="Table tent" nav={false}>
  <div class="print:hidden mx-auto max-w-md rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-600">
    <p><strong>Table tent (A6 panels).</strong> Print double-sided on card stock, fold along the middle. Use your browser's Print, then Save as PDF for the shop.</p>
    <p class="mt-2 text-xs text-slate-500">Full-color design: a print shop handles it as-is. On an office printer, enable "Background graphics" in the print dialog.</p>
    <button id="tent-print" class="mt-3 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-semibold text-white">Print</button>
  </div>

  <div id="tent" class="tent mx-auto mt-6">
    <div class="panel">
      <p class="brand">
        <img id="tent-logo" class="brandimg" alt="FitCreature" hidden />
        <span id="tent-brandtext"><span class="fit">Fit</span><span class="creature">Creature</span></span>
      </p>
      <p id="tent-copy" class="copy"></p>
      <div class="qrcard">
        <div id="tent-qr" class="qr"></div>
      </div>
      <p class="code">CODE <span id="tent-code" class="mono"></span></p>
      <p class="hint">Scan with your camera, or enter the code in the app.</p>
      <div class="glow one"></div>
      <div class="glow two"></div>
    </div>
  </div>
</Portal>

<style>
  .tent { width: 105mm; }
  .panel {
    position: relative; overflow: hidden;
    padding: 12mm 10mm 10mm; text-align: center;
    background: linear-gradient(160deg, #1b1530 0%, #0a0815 78%);
    border-radius: 3mm;
    print-color-adjust: exact; -webkit-print-color-adjust: exact;
  }
  .brand { position: relative; z-index: 1; font-weight: 800; letter-spacing: 0.01em; font-size: 17pt; }
  .fit { color: #ffffff; }
  .creature { color: #f0c040; }
  .copy { position: relative; z-index: 1; margin-top: 4mm; font-size: 11.5pt; line-height: 1.35; color: #ffffff; font-weight: 600; }
  .qrcard {
    position: relative; z-index: 1;
    margin: 6mm auto 0; width: 62mm; padding: 3mm;
    background: #ffffff; border-radius: 2.5mm;
    box-shadow: 0 0 0 1mm rgba(240, 192, 64, 0.9);
  }
  .qr :global(svg) { display: block; width: 100%; height: auto; }
  .code { position: relative; z-index: 1; margin-top: 4.5mm; font-size: 9pt; letter-spacing: 0.2em; color: #c0c1ff; }
  .mono { font-family: ui-monospace, monospace; font-weight: 800; font-size: 13pt; letter-spacing: 0.18em; color: #f0c040; }
  .hint { position: relative; z-index: 1; margin-top: 2mm; font-size: 8pt; color: #9d9ab5; }
  .glow { position: absolute; border-radius: 50%; filter: blur(14mm); opacity: 0.55; }
  .glow.one { width: 60mm; height: 60mm; left: -22mm; top: -20mm; background: #6366f1; }
  .glow.two { width: 55mm; height: 55mm; right: -20mm; bottom: -18mm; background: #f0c040; opacity: 0.35; }
  .brandimg { display: block; margin: 0 auto; max-width: 60mm; max-height: 14mm; }
  /* Black & white: white ground, dark ink, no glows; the QR card keeps a
     plain border. The compositional layer for ink-friendly printing. */
  .tent.bw .panel { background: #ffffff; box-shadow: inset 0 0 0 0.6mm #111111; }
  .tent.bw .fit, .tent.bw .creature { color: #111111; }
  .tent.bw .copy { color: #111111; }
  .tent.bw .qrcard { box-shadow: inset 0 0 0 0.5mm #111111; padding: 2.5mm; }
  .tent.bw .code { color: #444444; }
  .tent.bw .mono { color: #111111; }
  .tent.bw .hint { color: #666666; }
  .tent.bw .glow { display: none; }
  @media print {
    :global(header), .print\:hidden { display: none !important; }
    .tent { margin: 0; }
    .panel { border-radius: 0; }
    @page { size: A6 portrait; margin: 0; }
  }
</style>

<script>
  import { requireSession, callFn, callFnJson, el, show } from '../../lib/portal';

  // Style variant (?style=bw|color) + the brand slot: a logo FILE from the
  // brand library wins when present; the styled-text wordmark is the
  // fallback (public/brand/MANIFEST.md rule).
  const bw = new URLSearchParams(location.search).get('style') === 'bw';
  if (bw) document.getElementById('tent')!.classList.add('bw');
  const logo = el<HTMLImageElement>('tent-logo');
  logo.addEventListener('load', () => {
    logo.hidden = false;
    el('tent-brandtext').hidden = true;
  });
  logo.src = bw ? '/assets/brand/logos/fc_logo_black.png' : '/assets/brand/logos/fc_logo_white.png';

  void requireSession().then(async () => {
    const manifest = await callFnJson<Record<string, any>>('partner_print_pack', { format: 'manifest' });
    el('tent-code').textContent = manifest.code;
    el('tent-copy').textContent = manifest.copy[0];
    const svgRes = await callFn('partner_print_pack', { variant: 'standard', format: 'svg' });
    el('tent-qr').innerHTML = await svgRes.text();
  }).catch((err) => {
    if (!String(err).includes('redirecting')) {
      document.querySelector('.panel')?.insertAdjacentHTML('afterbegin',
        `<p style="color:#e11d48;font-size:12px">Could not load the pack (${err}). Refresh to retry.</p>`);
    }
  });
  document.getElementById('tent-print')?.addEventListener('click', () => window.print());
</script>
