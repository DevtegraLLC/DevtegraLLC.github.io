---
import Base from '../layouts/Base.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Devtegra, LLC',
  url: 'https://devtegra.com',
  email: 'contact.us@devtegra.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Round Rock',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
};
---

<Base
  title="Devtegra | Develop with Integrity"
  description="Devtegra is a software studio in Round Rock, Texas building mobile apps focused on user wellbeing, privacy, and long-term trust. No dark patterns, no data sales, no surprises."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-6 py-24 text-center">
    <h1 class="text-5xl font-bold tracking-tight text-slate-900 sm:text-6xl">
      Develop with Integrity<span class="text-indigo-500">.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
      We build software that treats people well. No dark patterns, no data sales,
      no surprises, just products that work.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="grid gap-8 sm:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 p-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">What we do</p>
        <h2 class="mt-3 text-2xl font-semibold text-slate-900">Software development</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Devtegra is a software studio based in Round Rock, Texas. We build mobile
          applications focused on user wellbeing, privacy, and long-term trust. Our
          first product, FitCreature, launches on iOS and Android in 2026.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 p-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Our motto</p>
        <h2 class="mt-3 text-2xl font-semibold text-slate-900">Integrity, not profit-making</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Integrity isn't a slogan, it's how we make product decisions. Every feature
          we ship has to earn its place: does it respect the user's time, health, and
          data? Profit follows from doing that well. Not the other way around.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <a
      href="/fitcreature"
      class="group flex flex-col items-center gap-6 rounded-2xl bg-indigo-500 p-10 text-white transition-colors hover:bg-indigo-600 sm:flex-row"
    >
      <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-white p-3 shadow-md">
        <img src="/images/fitcreature-icon.png" alt="" width="56" height="56" />
      </span>
      <span>
        <span class="block text-2xl font-semibold">FitCreature: Coming 2026</span>
        <span class="mt-2 block text-indigo-100">
          A fitness app with a twist. Every real workout shapes a creature of your own.
          Launching on the App Store and Google Play in 2026.
        </span>
      </span>
      <span class="ml-auto hidden text-3xl transition-transform group-hover:translate-x-1 sm:block" aria-hidden="true">&rarr;</span>
    </a>
  </section>
</Base>
