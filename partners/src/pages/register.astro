---
import Portal from '../layouts/Portal.astro';

// Public partner-interest intake (F91 step 13, FitCreature Decision 6.134).
// Collects business name + contact name + email + phone and POSTs the public
// `partner_inquiry` edge function (CORS pin, honeypot, Turnstile, Postgres
// rate limiter server-side). Submitting creates a lead row only; accounts
// stay provisioned by the FitCreature team after follow-up.
//
// The Turnstile SITE key is public (safe to embed); it is the same
// "FitCreature Turnstile" widget the devtegra.com/beta form uses. The real
// secret lives server-side on the edge function.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAD0AwX_WOU72V94u';
---

<Portal title="Register interest" nav={false}>
  <div class="mx-auto mt-16 max-w-sm">
    <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">FitCreature Partners</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">Put your business in the app</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">
      Tell us who you are and we'll reach out to talk through a partnership: your listing on the
      players' Social tab, an in-store perk, and a scannable code with printed material for your space.
    </p>

    <form id="register-form" class="mt-8 space-y-4" novalidate>
      <div>
        <label for="business-name" class="block text-sm font-medium">Business name</label>
        <input id="business-name" type="text" required autocomplete="organization" placeholder="The Iron Temple"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
      </div>
      <div>
        <label for="contact-name" class="block text-sm font-medium">Contact name</label>
        <input id="contact-name" type="text" required autocomplete="name" placeholder="Alex Rivera"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium">Email</label>
        <input id="email" type="email" required autocomplete="email" placeholder="you@yourbusiness.com"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium">Phone</label>
        <input id="phone" type="tel" required autocomplete="tel" placeholder="(512) 555-0100"
          class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" />
      </div>

      {/* Honeypot: hidden from humans, tempting to naive bots. A filled value is
          silently dropped server-side. Off-screen (not display:none) so bots that
          skip hidden fields still see it. */}
      <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden">
        <label for="website">Website (leave blank)</label>
        <input type="text" id="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>

      <p id="register-error" class="text-sm text-rose-600" hidden></p>
      <button type="submit" id="register-submit"
        class="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-50">
        Send it our way
      </button>
    </form>

    <div id="register-success" hidden class="mt-8 rounded-xl border border-emerald-200 bg-emerald-50 p-5">
      <h2 class="text-base font-semibold text-emerald-900">Got it, thanks!</h2>
      <p class="mt-2 text-sm leading-relaxed text-emerald-800">
        We'll be in touch soon to talk through the partnership. Nothing else to do for now.
      </p>
    </div>

    <p class="mt-8 text-xs leading-relaxed text-slate-400">
      Already a partner? <a class="underline" href="/">Sign in here.</a>
    </p>
    <p class="mt-3 text-xs leading-relaxed text-slate-400">
      We use these details only to contact you about a FitCreature partnership. This form is
      protected by Cloudflare Turnstile.
    </p>
  </div>
</Portal>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { functionsUrl } from '../lib/supabase';
  import { el, show } from '../lib/portal';

  const form = el<HTMLFormElement>('register-form');

  function fail(text: string): void {
    const node = el('register-error');
    node.textContent = text;
    node.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    show('register-error', false);

    const businessName = el<HTMLInputElement>('business-name').value.trim();
    const contactName = el<HTMLInputElement>('contact-name').value.trim();
    const email = el<HTMLInputElement>('email').value.trim();
    const phone = el<HTMLInputElement>('phone').value.trim();
    const website = el<HTMLInputElement>('website').value;
    const turnstileToken =
      (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value ?? '';

    if (!businessName) return fail('Please enter your business name.');
    if (!contactName) return fail('Please enter a contact name.');
    if (!email) return fail('Please enter your email.');
    if (!phone) return fail('Please enter a phone number.');
    if (!turnstileToken) return fail('Please complete the verification and try again.');

    const button = el<HTMLButtonElement>('register-submit');
    button.disabled = true;
    button.textContent = 'Sending...';

    const reset = () => {
      button.disabled = false;
      button.textContent = 'Send it our way';
      try {
        (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
      } catch {
        /* ignore */
      }
    };

    try {
      const res = await fetch(functionsUrl('partner_inquiry'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ businessName, contactName, email, phone, website, turnstileToken }),
      });

      if (res.ok) {
        let body: Record<string, unknown> = {};
        try {
          body = await res.json();
        } catch {
          /* ignore */
        }
        if (body.status === 'closed') {
          fail("We aren't taking new partner inquiries right now. Check back soon.");
          reset();
          return;
        }
        form.hidden = true;
        show('register-success', true);
        return;
      }

      if (res.status === 429) {
        fail("You've tried a few times in a row. Wait a little while and try again.");
      } else if (res.status === 400) {
        fail('Please double-check your email and the verification, then try again.');
      } else {
        fail('Something went wrong on our end. Please try again in a moment.');
      }
      reset();
    } catch {
      fail('We could not reach the server. Check your connection and try again.');
      reset();
    }
  });
</script>
