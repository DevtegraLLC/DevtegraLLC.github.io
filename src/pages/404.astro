---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Devtegra" description="This page could not be found." noindex>
  <div class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900">Page not found</h1>
    <p class="mt-4 text-slate-600">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-indigo-500 px-6 py-3 font-medium text-white transition-colors hover:bg-indigo-600">
      Back to the homepage
    </a>
  </div>
</Base>
